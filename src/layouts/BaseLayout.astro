---
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/noto-serif-sc';
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/source-serif-4';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { applyInitialTheme, themeConfig } from '../lib/browser/theme-config';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StudyRoom from '../components/study-room/StudyRoom.astro';
import { musicConfig } from '../config/music';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  pageKind?: 'home' | 'article' | 'index' | 'utility';
  noindex?: boolean;
  includeCanonical?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  headline?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  pageKind = 'index',
  noindex = false,
  includeCanonical = true,
  publishedTime,
  modifiedTime,
  headline,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const siteRoot = new URL(withBase('/'), Astro.site ?? Astro.url).href;
const rssUrl = new URL(withBase('/rss.xml'), Astro.site ?? Astro.url).href;
const musicEnabled = siteConfig.features.studyRoom
  && siteConfig.features.music
  && musicConfig.tracks.length > 0;
const articleStructuredData = pageKind === 'article' && publishedTime
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: headline ?? title,
      description,
      inLanguage: 'zh-CN',
      datePublished: publishedTime.toISOString(),
      dateModified: (modifiedTime ?? publishedTime).toISOString(),
      author: { '@type': 'Person', name: siteConfig.author },
      mainEntityOfPage: canonical.href,
      isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: siteRoot },
    }).replaceAll('<', '\\u003c')
  : undefined;
---

<!doctype html>
<html lang={siteConfig.language} data-theme="system" transition:animate="none">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" data-theme-color />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    {includeCanonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={rssUrl} />
    <meta property="og:type" content={pageKind === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {includeCanonical && <meta property="og:url" content={canonical} />}
    {pageKind === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {pageKind === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {articleStructuredData && <script is:inline type="application/ld+json" set:html={articleStructuredData}></script>}
    <title>{title}</title>
    <script is:inline set:html={`(${applyInitialTheme.toString()})(${JSON.stringify(themeConfig)});`}></script>
  </head>
  <body
    data-page-kind={pageKind}
    data-feature-study-room={String(siteConfig.features.studyRoom)}
    data-feature-music={String(musicEnabled)}
    data-feature-mermaid={String(siteConfig.features.mermaid)}
    data-feature-lightbox={String(siteConfig.features.lightbox)}
  >
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>import '../scripts/reading-memory';</script>
    {siteConfig.features.studyRoom && <StudyRoom />}
    {siteConfig.features.lightbox && (
      <dialog class="lightbox" data-lightbox aria-label="图片预览" aria-describedby="lightbox-caption">
        <button type="button" data-lightbox-close aria-label="关闭图片预览">关闭</button>
        <img alt="" data-lightbox-image />
        <p id="lightbox-caption" data-lightbox-caption></p>
      </dialog>
    )}
    <script>import '../features/page-features';</script>
  </body>
</html>
