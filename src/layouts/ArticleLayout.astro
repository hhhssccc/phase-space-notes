---
import '../features/reading/article-tools.css';
import ReadingPath from '../components/ReadingPath.astro';
import SymbolGuide from '../components/SymbolGuide.astro';
import FormulaTools from '../components/FormulaTools.astro';
import PhysicsLab from '../components/PhysicsLab.astro';
import { analyzeArticle } from '../lib/content/analysis';
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import ArticleHistory from '../components/ArticleHistory.astro';
import InlineMarkup from '../components/InlineMarkup.astro';
import { siteConfig } from '../config/site';
import { entryUrl, formatDate, readingMinutes, withBase, type ArticleEntry } from '../lib/content';
import { renderInlineMarkup } from '../lib/inline-markup';
import 'katex/dist/katex.min.css';
import '../styles/article-performance.css';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  post: ArticleEntry;
  headings: Heading[];
  relatedEntries: ArticleEntry[];
  backlinkEntries: ArticleEntry[];
}

const { post, headings, relatedEntries, backlinkEntries } = Astro.props;
const minutes = readingMinutes(post.body || '');
const typeLabel = post.data.type === 'note' ? 'NOTE' : 'ESSAY';
// Normalize line endings so the adaptive layout is identical on Windows and CI/Linux.
const analysis = analyzeArticle(post.body || '');
const renderedHeadings = headings.filter((heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label');
const sourceHeadings = analysis.headings.filter(h => h.depth === 2 || h.depth === 3);
const toc = await Promise.all(renderedHeadings.map(async (heading, index) => ({
  ...heading,
  html: await renderInlineMarkup(
    sourceHeadings[index]?.depth === heading.depth ? sourceHeadings[index].text : heading.text,
  ),
})));
const sidenotes = await Promise.all(post.data.sidenotes.map(async (note) => ({
  ...note,
  titleHtml: await renderInlineMarkup(note.title),
  bodyHtml: await renderInlineMarkup(note.body),
})));
const effectiveMathDisplay = post.data.mathDisplay === 'auto'
  ? analysis.mathDisplay
  : post.data.mathDisplay;
---

<BaseLayout
  title={`${post.data.title}｜${siteConfig.name}`}
  description={post.data.description}
  pageKind="article"
  publishedTime={post.data.date}
  modifiedTime={post.data.updated || post.data.date}
  headline={post.data.title}
>
  {siteConfig.features.readingProgress && <div class="reading-progress" data-reading-progress aria-hidden="true"></div>}
  <div class="article-shell">
    <aside class="article-toc print-hidden" aria-label="文章目录">
      <p>目录</p>
      <ol>
        {toc.map((heading) => (
          <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}><InlineMarkup html={heading.html} /></a></li>
        ))}
      </ol>
      <small>{minutes} 分钟 · {post.body?.length.toLocaleString('zh-CN')} 字符</small>
    </aside>

    <article class="article-main" id="article-start" data-reading-article data-reading-title={post.data.title}>
      <header class="article-title">
        <p class="eyebrow">{post.data.category.toUpperCase()} · {typeLabel}</p>
        <h1>{post.data.title}</h1>
        <p class="article-dek">{post.data.description}</p>
        <p class="article-meta">
          {siteConfig.author} · {minutes} 分钟
          {' · '}首次公开 <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {post.data.updated && <> · 正文实质修订 <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time></>}
        </p>
      </header>

      <div class="reading-toolbar print-hidden">
        <a data-resume-reading hidden></a>
        <button type="button" data-add-bookmark>夹一枚书签</button>
        <button type="button" data-formula-mode aria-pressed="false" hidden>公式工具</button>
        <span data-reading-status role="status"></span>
        <span class="formula-hint" data-formula-hint hidden></span>
      </div>
      <SymbolGuide id={post.id} />

      {post.data.abstract && (
        <section class="abstract" aria-labelledby="abstract-title">
          <strong id="abstract-title">摘要</strong>
          <p>{post.data.abstract}</p>
        </section>
      )}

      {toc.length > 0 && (
        <details class="mobile-toc print-hidden">
          <summary>目录</summary>
          <ol>{toc.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}><InlineMarkup html={heading.html} /></a></li>)}</ol>
        </details>
      )}

      {sidenotes.length > 0 && (
        <details class="mobile-sidenotes print-hidden">
          <summary>边注</summary>
          {sidenotes.map((note) => <p><sup>{note.marker}</sup> <strong><InlineMarkup html={note.titleHtml} /></strong>：<InlineMarkup html={note.bodyHtml} /></p>)}
        </details>
      )}

      <div class="article-prose" data-math-display={effectiveMathDisplay}>
        <slot />
        <PhysicsLab id={post.id} />
      </div>

      {(post.data.tags.length > 0) && (
        <footer class="article-footer">
          <p class="article-tags">{post.data.tags.map((tag) => <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}</p>
        </footer>
      )}

      <FormulaTools />
      <ReadingPath id={post.id} />

      <ArticleHistory slug={post.id} date={post.data.date} updated={post.data.updated} />

      {(backlinkEntries.length > 0 || relatedEntries.length > 0) && (
        <section class="link-notes print-hidden" aria-label="延伸阅读">
          {backlinkEntries.length > 0 && <div><h2>反向链接</h2><ul>{backlinkEntries.map((entry) => <li><a href={entryUrl(entry)}>{entry.data.title}</a></li>)}</ul></div>}
          {relatedEntries.length > 0 && <div><h2>相关阅读</h2><ul>{relatedEntries.map((entry) => <li><a href={entryUrl(entry)}>{entry.data.title}</a></li>)}</ul></div>}
        </section>
      )}

      <Comments />
    </article>

    {sidenotes.length > 0 && (
      <aside class="margin-notes print-hidden" aria-label="边注">
        {sidenotes.map((note, index) => (
          <section style={`--note-offset: ${index === 0 ? 11 : 4}rem`}>
            <sup>{note.marker}</sup>
            <h2><InlineMarkup html={note.titleHtml} /></h2>
            <p><InlineMarkup html={note.bodyHtml} /></p>
          </section>
        ))}
      </aside>
    )}
  </div>
  {siteConfig.features.readingProgress && (
    <script>import '../features/reading/progress-entry';</script>
  )}
</BaseLayout>
