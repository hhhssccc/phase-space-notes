---
import { getCollection } from 'astro:content';
import EntryPreview from '../components/EntryPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { byNewest, entryUrl } from '../lib/content';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort(byNewest);
const grouped = Map.groupBy(entries, (entry) => String(entry.data.date.getFullYear()));
---

<BaseLayout title="归档｜渐近自由" description="按年份查看渐近自由的内容。" pageKind="index">
  <div class="index-page">
    <header class="index-header"><p class="eyebrow">ARCHIVE</p><h1>归档</h1><p>按写作时间排列。修订日期不会改变文章在这里的位置。</p></header>
    {[...grouped.entries()].map(([year, items]) => (
      <section class="archive-year"><h2>{year}</h2><ul>{items.map((entry) => <li><EntryPreview entry={entry} compact /><div><time datetime={entry.data.date.toISOString()}>{String(entry.data.date.getMonth() + 1).padStart(2, '0')}.{String(entry.data.date.getDate()).padStart(2, '0')}</time> <a href={entryUrl(entry)}>{entry.data.title}</a></div></li>)}</ul></section>
    ))}
  </div>
</BaseLayout>

<style>
  .archive-year li { grid-template-columns: 6rem minmax(0, 1fr); align-items: center; }
  .archive-year li:not(:has(img)) { grid-template-columns: 1fr; }
  .archive-year time { display: block; margin-bottom: .25rem; }
  @media print { .archive-year li { grid-template-columns: 1fr; } }
</style>
