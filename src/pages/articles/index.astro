---
import { getCollection } from 'astro:content';
import EntryListItem from '../../components/EntryListItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest } from '../../lib/content';

const entries = (await getCollection('articles', ({ data }) => !data.draft && data.type === 'essay')).sort(byNewest);
---

<BaseLayout title="文章｜渐近自由" description="厘清容易混淆的概念，试着找出复杂理论背后那个简单的想法。" pageKind="index">
  <div class="index-page">
    <header class="index-header"><p class="eyebrow">ESSAYS</p><h1>文章</h1><p>厘清容易混淆的概念，试着找出复杂理论背后那个简单的想法。</p></header>
    <ol class="entry-list">
      {entries.map((entry) => <EntryListItem entry={entry} />)}
    </ol>
  </div>
</BaseLayout>
