---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest, entryUrl, formatDate, readingMinutes } from '../../lib/content';

const entries = (await getCollection('articles', ({ data }) => !data.draft && data.type === 'note')).sort(byNewest);
---

<BaseLayout title="笔记｜渐近自由" description="写给自己的最简记录，尚未成型的理解与想法。" pageKind="index">
  <div class="index-page">
    <header class="index-header"><p class="eyebrow">NOTES</p><h1>笔记</h1><p>写给自己的最简记录，尚未成型的理解与想法。</p></header>
    {entries.length > 0 ? (
      <ol class="entry-list">
        {entries.map((entry) => <li><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time><div><h2><a href={entryUrl(entry)}>{entry.data.title}</a></h2><p>{entry.data.description}</p><span class="entry-meta">{entry.data.category} · {readingMinutes(entry.body || '')} 分钟</span></div></li>)}
      </ol>
    ) : (
      <p class="empty-state">暂时没有公开笔记。</p>
    )}
  </div>
</BaseLayout>
