---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import type { ArticleEntry } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft && data.type === 'note');
  return entries.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: ArticleEntry };
const { Content, headings } = await render(post);
const all = await getCollection('articles', ({ data }) => !data.draft);
const relatedEntries = post.data.related.map((id) => all.find((entry) => entry.id === id)).filter(Boolean) as ArticleEntry[];
const backlinkEntries = post.data.backlinks.map((id) => all.find((entry) => entry.id === id)).filter(Boolean) as ArticleEntry[];
---

<ArticleLayout {post} {headings} {relatedEntries} {backlinkEntries}><Content /></ArticleLayout>
