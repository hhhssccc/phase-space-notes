---
import { getCollection } from 'astro:content';
import EntryListItem from '../../components/EntryListItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest, type ArticleEntry } from '../../lib/content';

export async function getStaticPaths() {
  const all = await getCollection('articles', ({ data }) => !data.draft);
  const tags = [...new Set(all.flatMap((entry) => entry.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag, entries: all.filter((entry) => entry.data.tags.includes(tag)).sort(byNewest) } }));
}

const { tag, entries } = Astro.props as { tag: string; entries: ArticleEntry[] };
---

<BaseLayout title={`${tag}｜标签｜渐近自由`} description={`渐近自由中标记为“${tag}”的内容。`} pageKind="index">
  <div class="index-page">
    <header class="index-header"><p class="eyebrow">TAG</p><h1>#{tag}</h1><p>共 {entries.length} 篇内容。</p></header>
    <ol class="entry-list">{entries.map((entry) => <EntryListItem entry={entry} />)}</ol>
  </div>
</BaseLayout>
