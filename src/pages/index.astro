---
import '../styles/home-latest.css';
import { getCollection } from 'astro:content';
import EntryPreview from '../components/EntryPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { byNewest, entryUrl, readingMinutes, formatDate, withBase } from '../lib/content';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort(byNewest);
const featured = entries.filter((entry) => entry.data.type === 'essay' && entry.data.featured).slice(0, 3);
const notes = entries.filter((entry) => entry.data.type === 'note').slice(0, 4);
---

<BaseLayout pageKind="home">
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-intro">
        <p class="eyebrow">渐近自由</p>
        <h1 id="home-title"><span>从模型出发，</span><span>向结构深入。</span></h1>
        <p class="home-lede">读书时记下的推导、问题和偶尔想明白的事情。</p>
        <div class="home-actions">
          <a class="home-start-link" href="#featured-title">阅读精选</a>
          <a class="home-browse-link" href={withBase('/articles/')}>浏览文章</a>
        </div>
        <p class="home-byline">{siteConfig.author}</p>
      </div>
    </section>

    {entries[0] && <div class="home-latest">{entries[0].id === 'persuaded-ai' && <a class="latest-cover" href={entryUrl(entries[0])} aria-label={entries[0].data.title}><EntryPreview entry={entries[0]} compact /></a>}<span>最近发布</span><time datetime={entries[0].data.date.toISOString()}>{formatDate(entries[0].data.date, false)}</time><a href={entryUrl(entries[0])}>{entries[0].data.title}</a></div>}

    <section class="home-section" aria-labelledby="featured-title">
      <div class="section-heading"><h2 id="featured-title">精选文章</h2><a href={withBase('/articles/')}>全部文章 →</a></div>
      <ol class="featured-list">
        {featured.map((entry) => (
          <li class="home-preview-row">
            <EntryPreview entry={entry} compact />
            <div><a href={entryUrl(entry)}>{entry.data.title}</a>
            <span class="entry-meta">{entry.data.category} · {readingMinutes(entry.body || '')} 分钟</span></div>
          </li>
        ))}
      </ol>
    </section>

    {notes.length > 0 && (
      <section class="home-section" aria-labelledby="notes-title">
        <div class="section-heading"><h2 id="notes-title">近期笔记</h2><a href={withBase('/notes/')}>全部笔记 →</a></div>
        <ol class="note-list">
          {notes.map((entry) => (
            <li class="home-preview-row"><EntryPreview entry={entry} compact /><div><time datetime={entry.data.date.toISOString()}>{String(entry.data.date.getMonth() + 1).padStart(2, '0')}.{String(entry.data.date.getDate()).padStart(2, '0')}</time><a href={entryUrl(entry)}>{entry.data.title}</a></div></li>
          ))}
        </ol>
      </section>
    )}
    <section class="home-columns" aria-label="更多栏目">
      <a href={withBase('/reflections/')}><span class="eyebrow">REFLECTIONS</span><h2>杂感</h2><p>推导之外，生活之中。<br />最近的感想与偶然的收获。</p></a>
      <a href={withBase('/lab/')}><span class="eyebrow">THE VISUAL LAB</span><h2>演算室</h2><p>用代码把想法画出来。<br />调一调参数，看看会发生什么。</p></a>
    </section>
  </div>
</BaseLayout>

<style>
  .home-latest .latest-cover { flex: 0 0 6rem; align-self: center; }
  .home-preview-row { grid-template-columns: 6rem minmax(0, 1fr); align-items: center; gap: 1.4rem; padding-block: 1rem; }
  .home-preview-row a { font-family: var(--serif); font-size: 1.2rem; font-weight: 600; line-height: 1.5; }
  .home-preview-row .entry-meta { display: block; margin-top: .45rem; }
  .home-preview-row time { display: block; margin-bottom: .3rem; }
  @media (max-width: 48rem) { .home-preview-row { gap: 1rem; } .home-preview-row a { font-size: 1.05rem; } }
  @media print { .home-preview-row { grid-template-columns: 1fr; } }
</style>
