---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { byNewest, entryUrl, readingMinutes, withBase } from '../lib/content';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort(byNewest);
const featured = entries.filter((entry) => entry.data.type === 'essay' && entry.data.featured).slice(0, 3);
const notes = entries.filter((entry) => entry.data.type === 'note').slice(0, 4);
---

<BaseLayout pageKind="home">
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-intro">
        <p class="eyebrow">渐近自由</p>
        <h1 id="home-title">从模型出发，<br />向结构深入。</h1>
        <p class="home-lede">读书时记下的推导、问题和偶尔想明白的事情。</p>
        <p class="home-byline">{siteConfig.author}</p>
      </div>
      <figure class="home-mascot">
        <div class="home-mascot-stage">
          <img src={withBase(siteConfig.mascot.idle)} width="334" height="560" alt={`${siteConfig.mascot.name}扶帽站立`} fetchpriority="high" />
        </div>
      </figure>
    </section>

    <section class="home-section" aria-labelledby="featured-title">
      <div class="section-heading"><h2 id="featured-title">精选文章</h2><a href={withBase('/articles/')}>全部文章 →</a></div>
      <ol class="featured-list">
        {featured.map((entry) => (
          <li>
            <a href={entryUrl(entry)}>{entry.data.title}</a>
            <span class="entry-meta">{entry.data.category} · {readingMinutes(entry.body || '')} 分钟</span>
          </li>
        ))}
      </ol>
    </section>

    {notes.length > 0 && (
      <section class="home-section" aria-labelledby="notes-title">
        <div class="section-heading"><h2 id="notes-title">近期笔记</h2><a href={withBase('/notes/')}>全部笔记 →</a></div>
        <ol class="note-list">
          {notes.map((entry) => (
            <li><time datetime={entry.data.date.toISOString()}>{String(entry.data.date.getMonth() + 1).padStart(2, '0')}.{String(entry.data.date.getDate()).padStart(2, '0')}</time><a href={entryUrl(entry)}>{entry.data.title}</a></li>
          ))}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>
