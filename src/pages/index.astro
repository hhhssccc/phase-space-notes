---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/front-page.css';
import GammaPlate from '../components/GammaPlate.astro';
import HomeSections from '../components/HomeSections.astro';
import EntryPreview from '../components/EntryPreview.astro';
import { byNewest, entryUrl } from '../lib/content';
import { getPublicContent } from '../lib/content/service';

const { entries } = await getPublicContent();
entries.sort(byNewest);
const lead = entries.find(entry => entry.data.homeLeadEligible);
const leadDescription = lead?.id === 'special-functions'
  ? lead.data.description.replace(/的手写笔记(?=。?$)/u, '')
  : lead?.data.description;
const issueDate = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'long', timeZone: 'UTC' });
---

<BaseLayout pageKind="home">
  {lead && (
    <div class:list={['lead-plate', { 'gamma-cover': lead.id === 'special-functions' }]}>
      {lead.id === 'special-functions' ? <GammaPlate /> : (
        <a href={entryUrl(lead)} aria-label={`阅读《${lead.data.title}》`}>
          <EntryPreview entry={lead} sizes="100vw" loading="eager" />
        </a>
      )}
    </div>
  )}
  <div class="journal-page">
    {lead && (
      <section class="lead-story-heading" aria-labelledby="lead-title" data-home-entry={lead.id}>
        <div class="lead-copy">
          <div class="lead-heading">
            <p class="lead-meta">
              <span>{lead.data.category}</span>
              <time datetime={lead.data.date.toISOString()}><span class="visually-hidden">发布于</span>{issueDate.format(lead.data.date)}</time>
            </p>
            <h2 id="lead-title"><a href={entryUrl(lead)}>{lead.data.title}</a></h2>
          </div>
          <p class="lead-dek">{leadDescription}</p>
        </div>
      </section>
    )}
  </div>
  <HomeSections entries={entries} leadId={lead?.id ?? ''} />
</BaseLayout>

<script>
  import { registerPageFeature } from '../lib/browser/lifecycle';

  registerPageFeature('cover-header', () => {
    const cover = document.querySelector('.gamma-cover');
    const header = document.querySelector<HTMLElement>('.journal-header');
    if (!cover || !header || !('IntersectionObserver' in window)) return;
    header.classList.add('cover-aware');
    const observer = new IntersectionObserver(([entry]) => {
      header.classList.toggle('past-cover', !entry.isIntersecting);
    }, { rootMargin: '-80px 0px 0px' });
    observer.observe(cover);
    return () => observer.disconnect();
  });
</script>
