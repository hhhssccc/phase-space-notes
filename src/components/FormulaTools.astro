---
import '../features/reading/formulas.css';
---
<div id="formula-menu" class="formula-menu print-hidden" data-formula-menu role="dialog" aria-label="公式工具" hidden>
  <button type="button" data-formula-copy="tex">复制 LaTeX</button>
  <button type="button" data-formula-copy="link">复制公式链接</button>
  <span class="formula-feedback" data-formula-feedback role="status" aria-live="polite"></span>
</div>
<p class="visually-hidden print-hidden" data-formula-status role="status" aria-live="polite"></p>
<dialog class="copy-dialog print-hidden" data-copy-dialog aria-labelledby="copy-dialog-title">
  <h2 id="copy-dialog-title">复制内容</h2><p>自动复制不可用，请选中下面的内容后复制。</p>
  <textarea aria-label="待复制内容" readonly></textarea>
  <button type="button" data-copy-close>关闭</button>
</dialog>
<script>import '../features/reading/formulas';</script>
