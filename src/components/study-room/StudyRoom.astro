---
import { getCollection } from 'astro:content';
import { musicConfig } from '../../config/music';
import { siteConfig } from '../../config/site';
import { byRecentlyChanged, entryUrl, withBase } from '../../lib/content';
import { getSiteStats } from '../../lib/site-stats';
import MusicPlayer from './MusicPlayer.astro';
import SiteStats from './SiteStats.astro';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort(byRecentlyChanged);
const latest = entries.slice(0, 3);
const stats = getSiteStats(entries);
const studyAvatar = withBase(siteConfig.mascot.studyAvatar);
const hasMusicTracks = siteConfig.features.music && musicConfig.tracks.length > 0;
const formatUpdateDate = new Intl.DateTimeFormat('zh-CN', {
  month: '2-digit',
  day: '2-digit',
  timeZone: 'UTC',
});
---

<button
  class="study-trigger"
  type="button"
  data-study-open
  aria-controls="study-room-drawer"
  aria-expanded="false"
>
  <img
    src={studyAvatar}
    width="256"
    height="256"
    alt=""
    decoding="async"
  />
  <span>书房</span>
</button>

<div class="study-backdrop" data-study-backdrop hidden aria-hidden="true"></div>

<aside
  class="study-drawer"
  id="study-room-drawer"
  data-study-drawer
  data-wallpaper="plain"
  data-wallpaper-enabled={String(siteConfig.features.wallpaper)}
  role="dialog"
  aria-modal="true"
  aria-labelledby="study-room-title"
  aria-hidden="true"
  hidden
  inert
>
  <div class="drawer-topbar">
    <p>渐近自由</p>
    <button type="button" class="drawer-close" data-study-close aria-label="关闭书房">
      <span aria-hidden="true">×</span>
      <span class="visually-hidden">关闭书房</span>
    </button>
  </div>

  <div class="drawer-content">
    <header class="room-intro">
      <h2 id="study-room-title">夜读书房</h2>
      <p class="room-description">调好光线，留一点声音，继续阅读。</p>
    </header>

    <section class="room-section preference-section" aria-labelledby="appearance-title">
      <div class="section-heading">
        <h3 id="appearance-title">阅读环境</h3>
      </div>

      <div class="preference-row">
        <p id="theme-label">主题</p>
        <div class="segmented" role="group" aria-labelledby="theme-label">
          <button type="button" data-study-theme="light" aria-pressed="false">浅色</button>
          <button type="button" data-study-theme="dark" aria-pressed="false">深色</button>
          <button type="button" data-study-theme="system" aria-pressed="false">系统</button>
        </div>
      </div>

      {siteConfig.features.wallpaper && (
        <div class="preference-row">
          <p id="wallpaper-label">页面纸面</p>
          <div class="segmented" role="group" aria-labelledby="wallpaper-label">
            <button type="button" data-study-wallpaper="plain" aria-pressed="false">纯纸</button>
            <button type="button" data-study-wallpaper="grid" aria-pressed="false">方格</button>
            <button type="button" data-study-wallpaper="orbit" aria-pressed="false">轨道</button>
          </div>
          <small>纸面选择会应用到全站。</small>
        </div>
      )}
    </section>

    {hasMusicTracks && (
      <section class="room-section" aria-labelledby="music-section-title">
        <div class="section-heading">
          <h3 id="music-section-title">书房音乐</h3>
        </div>
        <MusicPlayer />
      </section>
    )}

    <section class="room-section" aria-labelledby="updates-title">
      <div class="section-heading">
        <h3 id="updates-title">最近动态</h3>
      </div>
      {latest.length > 0 ? (
        <ol class="recent-list">
          {latest.map((entry) => {
            const updated = entry.data.updated ?? entry.data.date;
            return (
              <li>
                <div>
                  <a href={entryUrl(entry)}>{entry.data.title}</a>
                  <p>
                    <span>{entry.data.type === 'essay' ? '文章' : '笔记'} · {entry.data.category}</span>
                    <time datetime={updated.toISOString()}>{formatUpdateDate.format(updated)}</time>
                  </p>
                </div>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="empty-state">暂时没有公开内容。</p>
      )}
    </section>

    {siteConfig.features.stats && (
      <div class="room-section stats-section">
        <SiteStats stats={stats} />
      </div>
    )}

  </div>
</aside>

<script>
  const THEME_KEY = 'asymptotic-freedom-theme';
  const WALLPAPER_KEY = 'asymptotic-freedom-wallpaper';
  const themes = ['light', 'dark', 'system'] as const;
  const wallpapers = ['plain', 'grid', 'orbit'] as const;
  type Theme = (typeof themes)[number];
  type Wallpaper = (typeof wallpapers)[number];

  const trigger = document.querySelector<HTMLButtonElement>('[data-study-open]');
  const drawer = document.querySelector<HTMLElement>('[data-study-drawer]');
  const backdrop = document.querySelector<HTMLElement>('[data-study-backdrop]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-study-close]');
  const root = document.documentElement;
  const body = document.body;
  const wallpaperEnabled = drawer?.dataset.wallpaperEnabled === 'true';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let returnFocus: HTMLElement | null = null;
  let invokingTrigger: HTMLElement | null = null;
  let closeTimer: number | undefined;
  let isOpen = false;
  const previousInertStates = new Map<Element, boolean>();

  const readStorage = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };

  const writeStorage = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {
      // The selected preference still applies for this page when storage is unavailable.
    }
  };

  const isTheme = (value: string | null): value is Theme => value !== null && themes.includes(value as Theme);
  const isWallpaper = (value: string | null): value is Wallpaper => value !== null && wallpapers.includes(value as Wallpaper);

  const syncThemeControls = () => {
    const activeTheme = isTheme(root.dataset.theme ?? null) ? root.dataset.theme : 'system';
    document.querySelectorAll<HTMLButtonElement>('[data-study-theme]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.studyTheme === activeTheme));
    });
  };

  const applyTheme = (theme: Theme) => {
    root.dataset.theme = theme;
    writeStorage(THEME_KEY, theme);
    syncThemeControls();
  };

  const applyWallpaper = (wallpaper: Wallpaper) => {
    const activeWallpaper = wallpaperEnabled ? wallpaper : 'plain';
    if (wallpaperEnabled) body.dataset.wallpaper = activeWallpaper;
    else body.removeAttribute('data-wallpaper');
    if (drawer) drawer.dataset.wallpaper = activeWallpaper;
    document.querySelectorAll<HTMLButtonElement>('[data-study-wallpaper]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.studyWallpaper === activeWallpaper));
    });
  };

  const focusableElements = () => {
    if (!drawer) return [];
    return Array.from(drawer.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
    )).filter((element) => !element.hidden && element.getClientRects().length > 0);
  };

  const focusElement = (element: HTMLElement | null) => {
    if (!element) return;
    try {
      element.focus({ preventScroll: true });
    } catch {
      // Older Safari accepts focus(), but not the FocusOptions overload.
      element.focus();
    }
  };

  const focusDrawer = () => {
    focusElement(focusableElements()[0] ?? closeButton ?? drawer);
  };

  const setPageInert = (value: boolean) => {
    if (value) {
      previousInertStates.clear();
      Array.from(body.children).forEach((element) => {
        if (element === drawer || element === backdrop) return;
        previousInertStates.set(element, element.hasAttribute('inert'));
        element.setAttribute('inert', '');
      });
      return;
    }

    previousInertStates.forEach((wasInert, element) => {
      if (wasInert) element.setAttribute('inert', '');
      else element.removeAttribute('inert');
    });
    previousInertStates.clear();
  };

  const finishClose = () => {
    if (!drawer || !backdrop || isOpen) return;
    drawer.hidden = true;
    backdrop.hidden = true;
  };

  const openDrawer = (invoker: HTMLElement | null = null) => {
    if (!drawer || !backdrop || !trigger || isOpen) return;
    if (closeTimer !== undefined) window.clearTimeout(closeTimer);
    isOpen = true;
    invokingTrigger = invoker;
    returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : trigger;
    drawer.hidden = false;
    drawer.inert = false;
    drawer.setAttribute('aria-hidden', 'false');
    backdrop.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    trigger.setAttribute('aria-hidden', 'true');
    trigger.tabIndex = -1;
    body.classList.add('study-room-open');
    setPageInert(true);

    window.requestAnimationFrame(() => {
      window.requestAnimationFrame(() => {
        if (!isOpen) return;
        drawer.dataset.open = '';
        backdrop.dataset.open = '';
        focusDrawer();
      });
    });
  };

  const closeDrawer = () => {
    if (!drawer || !backdrop || !trigger || !isOpen) return;
    isOpen = false;
    drawer.removeAttribute('data-open');
    backdrop.removeAttribute('data-open');
    drawer.setAttribute('aria-hidden', 'true');
    drawer.inert = true;
    trigger.setAttribute('aria-expanded', 'false');
    trigger.removeAttribute('aria-hidden');
    trigger.removeAttribute('tabindex');
    body.classList.remove('study-room-open');
    setPageInert(false);
    const focusTarget = invokingTrigger?.isConnected
      ? invokingTrigger
      : returnFocus?.isConnected
        ? returnFocus
        : trigger;
    focusElement(focusTarget);
    // iOS/Safari can defer the inert-state update until the next frame.
    window.requestAnimationFrame(() => {
      if (!isOpen && document.activeElement !== focusTarget && focusTarget.isConnected) {
        focusElement(focusTarget);
      }
    });
    invokingTrigger = null;
    returnFocus = null;
    const transitionDelay = reducedMotion.matches ? 0 : 230;
    closeTimer = window.setTimeout(finishClose, transitionDelay);
  };

  trigger?.addEventListener('click', (event) => {
    openDrawer(event.currentTarget instanceof HTMLElement ? event.currentTarget : trigger);
  });
  closeButton?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  document.addEventListener('focusin', (event) => {
    if (!isOpen || !drawer) return;
    if (event.target instanceof Node && drawer.contains(event.target)) return;
    focusDrawer();
  });

  document.addEventListener('keydown', (event) => {
    if (!isOpen) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeDrawer();
      return;
    }
    if (event.key !== 'Tab') return;

    const focusable = focusableElements();
    if (focusable.length === 0) {
      event.preventDefault();
      closeButton?.focus();
      return;
    }
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-study-theme]').forEach((button) => {
    button.addEventListener('click', () => {
      const value = button.dataset.studyTheme ?? null;
      if (isTheme(value)) applyTheme(value);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-study-wallpaper]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!wallpaperEnabled) return;
      const value = button.dataset.studyWallpaper ?? null;
      if (!isWallpaper(value)) return;
      applyWallpaper(value);
      writeStorage(WALLPAPER_KEY, value);
    });
  });

  const themeObserver = new MutationObserver(syncThemeControls);
  themeObserver.observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  syncThemeControls();
  const storedWallpaper = wallpaperEnabled ? readStorage(WALLPAPER_KEY) : null;
  applyWallpaper(wallpaperEnabled && isWallpaper(storedWallpaper) ? storedWallpaper : 'plain');
</script>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .study-trigger { position: fixed; z-index: 58; right: max(0.85rem, env(safe-area-inset-right)); bottom: max(0.8rem, env(safe-area-inset-bottom)); display: grid; grid-template-columns: 2.35rem auto; align-items: center; gap: 0.42rem; min-height: 3rem; padding: 0.2rem 0.82rem 0.2rem 0.28rem; border: 0; border-radius: 999px; background: var(--paper-soft); box-shadow: 0 0.3rem 1rem var(--shadow); color: var(--ink); cursor: pointer; font-size: 0.8rem; font-weight: 600; line-height: 1; transition: background-color var(--ease); }
  .study-trigger:hover { background: color-mix(in srgb, var(--ink) 10%, var(--paper)); }
  .study-trigger img { display: block; width: 2.35rem; height: 2.35rem; object-fit: contain; filter: none !important; }
  .study-backdrop { position: fixed; z-index: 68; inset: 0; background: rgb(10 10 10 / 28%); opacity: 0; transition: opacity 220ms ease; }
  .study-backdrop[data-open] { opacity: 1; }
  .study-drawer { position: fixed; z-index: 69; inset: 0.75rem 0.75rem auto auto; width: min(28rem, calc(100% - 1.5rem)); height: calc(100dvh - 1.5rem); overflow: hidden auto; overscroll-behavior: contain; border: 0; border-radius: 1rem; background: var(--paper); box-shadow: 0 1rem 3rem var(--shadow); color: var(--ink); transform: translateX(calc(100% + 1rem)); visibility: hidden; transition: transform 220ms cubic-bezier(0.22,1,0.36,1), visibility 0s linear 220ms; }
  .study-drawer[data-open] { transform: translateX(0); visibility: visible; transition-delay: 0s; }
  .drawer-topbar { position: sticky; z-index: 2; top: 0; display: flex; align-items: center; justify-content: space-between; min-height: 4rem; padding: 0.6rem 2rem; background: var(--paper); }
  .drawer-topbar p { margin: 0; color: var(--muted); font-size: 0.8rem; }
  .drawer-close { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; padding: 0; border: 0; border-radius: 0.5rem; background: transparent; cursor: pointer; font-size: 1.55rem; font-weight: 300; line-height: 1; }
  .drawer-close:hover { background: var(--paper-soft); }
  .drawer-content { padding: 0 2rem max(2rem, env(safe-area-inset-bottom)); }
  .room-intro { padding: 1.25rem 0 1.5rem; }
  .room-intro h2 { margin: 0; font-family: var(--serif); font-size: 2.25rem; font-weight: 520; letter-spacing: -0.03em; line-height: 1.3; }
  .room-description { margin: 0.85rem 0 0; font-size: 0.85rem; line-height: 1.8; color: var(--muted); }
  .room-section { padding: 1.5rem 0; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .section-heading h3 { margin: 0; font-family: var(--serif); font-size: 1.15rem; font-weight: 650; letter-spacing: 0; }
  .preference-row + .preference-row { margin-top: 1.25rem; }
  .preference-row > p { margin: 0 0 0.6rem; color: var(--ink-soft); font-size: 0.85rem; }
  .preference-row small { display: block; margin-top: 0.6rem; color: var(--muted); font-size: 0.75rem; line-height: 1.6; }
  .segmented { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 0.3rem; padding: 0.3rem; border-radius: 0.75rem; background: var(--paper-soft); }
  .segmented button { min-width: 0; min-height: 2.75rem; padding: 0.5rem 0.25rem; border: 0; border-radius: 0.5rem; background: transparent; color: var(--muted); cursor: pointer; font-size: 0.85rem; line-height: 1.2; transition: background-color var(--ease), color var(--ease); }
  .segmented button:hover { color: var(--ink); }
  .segmented button[aria-pressed='true'] { background: var(--paper); color: var(--ink); font-weight: 600; box-shadow: 0 1px 4px var(--shadow); }
  .recent-list { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .recent-list li { position: relative; padding: 0.85rem 0.6rem; margin-inline: -0.6rem; border-radius: 0.5rem; }
  .recent-list li:hover, .recent-list li:focus-within { background: var(--paper-soft); }
  .recent-list a { display: block; overflow-wrap: anywhere; font-family: var(--serif); font-size: 1rem; font-weight: 620; line-height: 1.6; text-decoration: none; }
  .recent-list a::after { content: ''; position: absolute; inset: 0; border-radius: 0.5rem; }
  .recent-list p { display: flex; justify-content: space-between; gap: 0.65rem; margin: 0.45rem 0 0; color: var(--muted); font-size: 0.75rem; line-height: 1.5; }
  .recent-list time { flex: none; font-variant-numeric: tabular-nums; }
  .empty-state { margin: 0; color: var(--muted); font-size: 0.85rem; }
  :global(body.study-room-open) {
    overflow: hidden;
  }

  :global(body[data-wallpaper='grid']) {
    background-image:
      linear-gradient(color-mix(in srgb, var(--rule-soft) 62%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--rule-soft) 62%, transparent) 1px, transparent 1px);
    background-size: 2rem 2rem;
  }

  :global(body[data-wallpaper='orbit']) {
    background-image:
      radial-gradient(circle at 92% 15%, transparent 0 12rem, color-mix(in srgb, var(--rule) 42%, transparent) 12.04rem 12.1rem, transparent 12.16rem),
      radial-gradient(circle at 92% 15%, transparent 0 7.5rem, color-mix(in srgb, var(--rule-soft) 72%, transparent) 7.54rem 7.6rem, transparent 7.66rem);
  }

  @media (max-width: 40rem) {
    .drawer-topbar { padding-inline: 1rem; }
    .study-trigger {
      right: max(0.38rem, env(safe-area-inset-right));
      bottom: max(0.38rem, env(safe-area-inset-bottom));
      grid-template-columns: 2.25rem;
      width: 2.8rem;
      min-height: 2.8rem;
      padding: 0.14rem;
      place-content: center;
    }

    .study-trigger img {
      width: 2.25rem;
      height: 2.25rem;
    }

    .study-trigger span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .drawer-content {
      padding-inline: 1rem;
    }
  }

  @media (max-width: 22rem) {
    .drawer-topbar { padding-inline: 0.85rem; }
    .drawer-content {
      padding-inline: 0.85rem;
    }

    .room-intro h2 {
      font-size: 1.65rem;
    }

    .segmented button {
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .study-trigger,
    .study-backdrop,
    .study-drawer {
      transition-duration: 0.01ms;
    }

    .study-trigger:hover {
      transform: none;
    }
  }

  @media print {
    :global(body.study-room-open) {
      overflow: visible !important;
    }

    .study-trigger,
    .study-backdrop,
    .study-drawer {
      display: none !important;
    }
  }
</style>
