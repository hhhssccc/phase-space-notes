---
import { getCollection } from 'astro:content';
import { contentKinds } from '../../lib/content-kinds.mjs';
import { musicConfig } from '../../config/music';
import { siteConfig } from '../../config/site';
import { byRecentlyChanged, entryUrl, withBase } from '../../lib/content';
import { getSiteStats } from '../../lib/site-stats';
import { getActivityHeatmap } from '../../lib/activity-heatmap';
import MusicPlayer from './MusicPlayer.astro';
import ReadingShelf from './ReadingShelf.astro';
import SiteStats from './SiteStats.astro';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort(byRecentlyChanged);
const latest = entries.slice(0, 3);
const stats = getSiteStats(entries);
const activity = getActivityHeatmap();
const studyAvatar = withBase(siteConfig.mascot.studyAvatar);
const hasMusicTracks = siteConfig.features.music && musicConfig.tracks.length > 0;
const formatUpdateDate = new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit', timeZone: 'UTC' });
const sections = [
  { id: 'reading', label: '阅读', description: '进度与书签', icon: 'M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1m0-15c3-2 6-2 9-1v15c-3-1-6-1-9 1V5Z' },
  ...(hasMusicTracks ? [{ id: 'music', label: '音乐', description: '播放与选曲', icon: 'M9 18V5l11-2v13M9 8l11-2M9 18c0 1.7-1.6 3-3.5 3S2 19.7 2 18s1.6-3 3.5-3S9 16.3 9 18Zm11-2c0 1.7-1.6 3-3.5 3S13 17.7 13 16s1.6-3 3.5-3S20 14.3 20 16Z' }] : []),
  { id: 'appearance', label: '环境', description: '光线与纸面', icon: 'M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z' },
  { id: 'records', label: '记录', description: '最近与积累', icon: 'M4 20V10m5 10V4m6 16v-7m5 7V7M2 21h20' },
];
---
<button transition:persist="study-trigger" class="study-trigger" type="button" data-study-open aria-controls="study-room-drawer" aria-expanded="false">
  <img src={studyAvatar} width="256" height="256" alt="" decoding="async" /><span>书房</span>
</button>
<div transition:persist="study-backdrop" class="study-backdrop" data-study-backdrop hidden aria-hidden="true"></div>
<aside transition:persist="study-drawer" class="study-drawer" id="study-room-drawer" data-study-drawer data-wallpaper="plain" data-wallpaper-enabled={String(siteConfig.features.wallpaper)} role="dialog" aria-modal="true" aria-labelledby="study-room-title" aria-hidden="true" hidden inert>
  <header class="drawer-topbar">
    <div><p class="room-kicker">渐近自由</p><h2 id="study-room-title">书房</h2></div>
    <button type="button" class="drawer-close" data-study-close aria-label="关闭书房"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </header>
  <div class="room-workspace">
    <nav class="room-nav" data-room-nav aria-label="书房分区">
      {sections.map((section, index) => <button type="button" data-room-jump={section.id} aria-controls={'study-' + section.id} aria-current={index === 0 ? 'location' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={section.icon} /></svg>
        <span><strong>{section.label}</strong><small>{section.description}</small></span>
      </button>)}
    </nav>
    <div class="drawer-content" data-room-scroll>
      <ReadingShelf entries={entries} />
      {hasMusicTracks && <section class="room-section music-section" id="study-music" data-room-section="music" aria-labelledby="music-section-title">
        <div class="section-heading"><h3 id="music-section-title" tabindex="-1">书房音乐</h3><span class="section-note">{musicConfig.tracks.length} 首选曲</span></div>
        <MusicPlayer />
      </section>}
      <section class="room-section preference-section" id="study-appearance" data-room-section="appearance" aria-labelledby="appearance-title">
        <div class="section-heading"><h3 id="appearance-title" tabindex="-1">阅读环境</h3></div>
        <div class="preference-row">
          <p id="theme-label">光线</p>
          <div class="preview-options" role="group" aria-labelledby="theme-label">
            {[['light','浅色'],['dark','深色'],['system','随系统']].map(([theme,label]) => <button type="button" data-study-theme={theme} aria-pressed="false">
              <span class:list={['theme-preview', 'theme-' + theme]} aria-hidden="true"><i class="sample-nav"></i><b>渐近自由</b><i class="sample-line"></i><i class="sample-line short"></i><i class="sample-image"></i></span>
              <span class="choice-label">{label}<i class="choice-check" aria-hidden="true">✓</i></span>
            </button>)}
          </div>
        </div>
        {siteConfig.features.wallpaper && <div class="preference-row">
          <p id="wallpaper-label">纸面 <small>应用到全站</small></p>
          <div class="preview-options" role="group" aria-labelledby="wallpaper-label">
            {[['plain','纯纸'],['grid','方格'],['orbit','轨道']].map(([paper,label]) => <button type="button" data-study-wallpaper={paper} aria-pressed="false">
              <span class:list={['paper-preview','paper-' + paper]} aria-hidden="true"><i></i></span>
              <span class="choice-label">{label}<i class="choice-check" aria-hidden="true">✓</i></span>
            </button>)}
          </div>
        </div>}
      </section>
      <section class="room-section records-section" id="study-records" data-room-section="records" aria-labelledby="updates-title">
        <div class="section-heading"><h3 id="updates-title" tabindex="-1">内容记录</h3></div>
        <h4 class="minor-heading">最近动态</h4>
        {latest.length > 0 ? <ol class="recent-list">{latest.map(entry => {
          const updated = entry.data.updated ?? entry.data.date;
          return <li><div class="recent-date"><time datetime={updated.toISOString()}>{formatUpdateDate.format(updated)}</time><span>{entry.data.updated ? '修订' : '发布'}</span></div><div><a href={entryUrl(entry)}>{entry.data.title}</a><p>{contentKinds[entry.data.type].label} · {entry.data.category}</p></div></li>;
        })}</ol> : <p class="empty-state">暂时没有公开内容。</p>}
        {siteConfig.features.stats && <div class="stats-section"><SiteStats stats={stats} /></div>}
        <section class="writing-calendar" aria-labelledby="study-activity-title">
          <div class="calendar-heading"><h4 id="study-activity-title">写作轨迹</h4><p>{activity.total} 次提交 · {activity.activeDays} 个活跃日</p></div>
          <p class="calendar-note">过去 53 周的站点仓库记录，每格代表一天。</p>
          <div class="calendar-scroll" tabindex="0" role="region" aria-label="全年写作轨迹，可横向滚动">
            <div class="calendar-chart">
              <div class="calendar-months" aria-hidden="true">{activity.months.map(month => <span style={'grid-column: ' + month.column}>{month.label}</span>)}</div>
              <div class="calendar-days">{activity.days.map(day => <span class:list={['calendar-day', 'level-' + day.level, { future: day.future }]} title={day.future ? undefined : day.date + '：' + day.count + ' 次提交'} aria-label={day.future ? undefined : day.date + '，' + day.count + ' 次提交'} aria-hidden={day.future ? 'true' : undefined}></span>)}</div>
            </div>
          </div>
          <div class="calendar-footer"><span>{activity.startDate} — {activity.endDate}</span><span class="calendar-legend" aria-label="灰色越深，提交越多">少 {[0,1,2,3,4].map(level => <i class={'calendar-day level-' + level} aria-hidden="true"></i>)} 多</span></div>
        </section>
      </section>
    </div>
  </div>
</aside>
<script>import '../../features/study-room/drawer';</script>
<style>
  .study-trigger { position: fixed; z-index: 58; right: max(.85rem, env(safe-area-inset-right)); bottom: max(.8rem, env(safe-area-inset-bottom)); display: grid; grid-template-columns: 2.35rem auto; align-items: center; gap: .42rem; min-height: 3rem; padding: .2rem .82rem .2rem .28rem; border: 0; border-radius: 999px; background: var(--paper-soft); box-shadow: 0 .3rem 1rem var(--shadow); color: var(--ink); cursor: pointer; font-size: .8rem; font-weight: 600; line-height: 1; transition: background-color var(--ease); }
  .study-trigger:hover { background: color-mix(in srgb,var(--ink) 10%,var(--paper)); }
  .study-trigger img { display: block; width: 2.35rem; height: 2.35rem; object-fit: contain; filter: none !important; }
  .study-backdrop { position: fixed; z-index: 68; inset: 0; background: rgb(10 10 10 / 36%); opacity: 0; transition: opacity 220ms ease; }
  .study-backdrop[data-open] { opacity: 1; }
  .study-drawer { position: fixed; z-index: 69; inset: 1rem 1rem 1rem auto; display: grid; grid-template-rows: auto minmax(0,1fr); width: min(62rem,calc(100% - 2rem)); height: calc(100dvh - 2rem); overflow: hidden; border: 0; border-radius: 1rem; background: var(--paper); box-shadow: 0 1rem 3rem var(--shadow); color: var(--ink); transform: translateX(calc(100% + 1rem)); visibility: hidden; transition: transform 220ms cubic-bezier(.22,1,.36,1), visibility 0s linear 220ms; }
  .study-drawer[hidden] { display: none; }
  .study-drawer[data-open] { transform: translateX(0); visibility: visible; transition-delay: 0s; }
  .drawer-topbar { display: flex; align-items: center; gap: 1.5rem; min-height: 6.2rem; padding: 1.1rem 1.5rem 1.1rem 1.75rem; }
  .room-kicker { margin: 0 0 .2rem; color: var(--muted); font-size: .67rem; letter-spacing: .06em; }
  .drawer-topbar h2 { margin: 0; font-family: var(--serif); font-size: 1.8rem; font-weight: 600; line-height: 1.3; }
  .room-description { margin: 0 0 0 auto; color: var(--muted); font-size: .76rem; line-height: 1.7; }
  .drawer-close { flex: none; display: grid; width: 2.75rem; height: 2.75rem; margin-left: auto; place-items: center; padding: 0; border: 0; border-radius: 50%; background: var(--paper-soft); color: var(--ink); cursor: pointer; }
  .drawer-close:hover { background: var(--rule-soft); }
  .room-workspace { display: grid; grid-template-columns: 8.25rem minmax(0,1fr); min-height: 0; }
  .room-nav { display: flex; flex-direction: column; gap: .45rem; padding: 1.2rem .6rem 1.2rem 1rem; background: var(--paper-soft); }
  .room-nav button { display: flex; align-items: center; gap: .65rem; min-width: 0; min-height: 3.6rem; padding: .65rem .6rem; border: 0; border-radius: .6rem; background: transparent; color: var(--muted); text-align: left; font: inherit; cursor: pointer; }
  .room-nav button:hover { color: var(--ink); background: color-mix(in srgb,var(--ink) 5%,transparent); }
  .room-nav button[aria-current='location'] { color: var(--ink); background: var(--paper); box-shadow: 0 1px 5px color-mix(in srgb,var(--shadow) 40%,transparent); }
  .room-nav svg { flex: none; width: 1.15rem; height: 1.15rem; }
  .room-nav strong { display: block; font-size: .85rem; font-weight: 650; }
  .room-nav small { display: block; margin-top: .15rem; font-size: .58rem; font-weight: 400; white-space: nowrap; }
  .drawer-content { min-width: 0; min-height: 0; overflow: hidden auto; overscroll-behavior: contain; padding: 0 2rem max(2rem,env(safe-area-inset-bottom)); scrollbar-width: thin; scrollbar-color: var(--rule) transparent; }
  .drawer-content :global(.room-section) { padding-block: 1.65rem 2rem; scroll-margin-top: 1rem; }
  .drawer-content :global(.room-section + .room-section) { border-top: 1px solid var(--rule-soft); }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.3rem; }
  .section-heading p { margin: 0 0 .35rem; color: var(--muted); font-size: .76rem; }
  .section-heading h3 { margin: 0; font-family: var(--serif); font-size: 1.65rem; font-weight: 620; line-height: 1.4; }
  .section-note { color: var(--muted); font-size: .7rem; white-space: nowrap; }
  .preference-row + .preference-row { margin-top: 1.75rem; }
  .preference-row > p { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 0 0 .7rem; color: var(--ink-soft); font-size: .85rem; font-weight: 600; }
  .preference-row p small { color: var(--muted); font-size: .7rem; font-weight: 400; }
  .preview-options { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .8rem; }
  .preview-options button { min-width: 0; min-height: 44px; padding: .5rem; border: 1px solid transparent; border-radius: .65rem; background: var(--paper-soft); color: var(--muted); cursor: pointer; font: inherit; text-align: left; }
  .preview-options button:hover { border-color: var(--rule); color: var(--ink); }
  .preview-options button[aria-pressed='true'] { border-color: var(--ink); color: var(--ink); }
  .choice-label { display: flex; align-items: center; justify-content: space-between; gap: .25rem; padding: .6rem .2rem .1rem; font-size: .8rem; }
  .choice-check { visibility: hidden; font-style: normal; font-size: .78rem; }
  [aria-pressed='true'] .choice-check { visibility: visible; }
  .theme-preview { position: relative; display: block; height: 6.5rem; overflow: hidden; padding: .8rem; border-radius: .3rem; background: #fff; color: #262626; }
  .theme-preview .sample-nav { display: block; height: .2rem; width: 70%; margin-bottom: .65rem; background: #aaa; }
  .theme-preview b { font-family: var(--serif); font-size: .7rem; font-weight: 650; }
  .sample-line { display: block; height: .15rem; width: 80%; margin-top: .4rem; background: #b5b5b5; }
  .sample-line.short { width: 57%; }
  .sample-image { position: absolute; width: 3rem; height: 2rem; bottom: -.4rem; right: .55rem; border-radius: 50%; border: 1px solid #aaa; transform: rotate(-25deg); }
  .theme-dark { background: #171819; color: #eee; }
  .theme-dark .sample-nav, .theme-dark .sample-line { background: #777; }
  .theme-dark .sample-image { border-color: #777; }
  .theme-system { background: linear-gradient(90deg,#fff 50%,#171819 50%); }
  .theme-system b { background: linear-gradient(90deg,#262626 50%,#eee 50%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .theme-system .sample-nav,.theme-system .sample-line { background: linear-gradient(90deg,#aaa 50%,#777 50%); }
  .paper-preview { position: relative; display: block; height: 5.4rem; overflow: hidden; border-radius: .3rem; background-color: var(--paper); }
  .paper-grid { background-image: linear-gradient(var(--rule-soft) 1px,transparent 1px),linear-gradient(90deg,var(--rule-soft) 1px,transparent 1px); background-size: .7rem .7rem; }
  .paper-orbit { background-image: radial-gradient(circle at 84% 20%,transparent 0 2.5rem,var(--rule) 2.54rem 2.58rem,transparent 2.62rem),radial-gradient(circle at 84% 20%,transparent 0 1.4rem,var(--rule-soft) 1.44rem 1.48rem,transparent 1.52rem); }
  .paper-preview i { position: absolute; display: block; width: 1.4rem; height: 1.6rem; top: .75rem; left: .8rem; border-left: 1px solid var(--muted); border-bottom: 1px solid var(--muted); opacity: .45; }
  .minor-heading,.calendar-heading h4 { margin: 0; font-size: .86rem; font-weight: 650; }
  .recent-list { display: grid; gap: .25rem; margin: .6rem 0 0; padding: 0; list-style: none; }
  .recent-list li { position: relative; display: grid; grid-template-columns: 3.2rem minmax(0,1fr); gap: .9rem; padding: .9rem .6rem; margin-inline: -.6rem; border-radius: .55rem; }
  .recent-list li:hover,.recent-list li:focus-within { background: var(--paper-soft); }
  .recent-date { color: var(--muted); font-size: .7rem; font-variant-numeric: tabular-nums; }
  .recent-date span { display: block; margin-top: .2rem; font-size: .6rem; }
  .recent-list a { display: block; color: var(--ink); overflow-wrap: anywhere; font-family: var(--serif); font-size: 1rem; font-weight: 620; line-height: 1.6; text-decoration: none; }
  .recent-list a::after { content: ''; position: absolute; inset: 0; border-radius: .5rem; }
  .recent-list p { margin: .35rem 0 0; color: var(--muted); font-size: .7rem; }
  .stats-section { margin-top: 2rem; }
  .writing-calendar { margin-top: 2rem; }
  .calendar-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem; }
  .calendar-heading p,.calendar-note,.calendar-footer { margin: 0; color: var(--muted); font-size: .68rem; line-height: 1.7; font-variant-numeric: tabular-nums; }
  .calendar-note { margin: .6rem 0 .85rem; }
  .calendar-scroll { max-width: 100%; overflow-x: auto; padding-bottom: .5rem; scrollbar-width: thin; }
  .calendar-chart { width: max-content; min-width: 100%; }
  .calendar-months,.calendar-days { display: grid; grid-template-columns: repeat(53,.5rem); gap: .15rem; grid-auto-flow: column; }
  .calendar-months { margin-bottom: .4rem; color: var(--muted); font-size: .56rem; }
  .calendar-months span { white-space: nowrap; }
  .calendar-days { grid-template-rows: repeat(7,.5rem); }
  .calendar-day { display: block; width: .5rem; height: .5rem; border-radius: .13rem; background: var(--paper-soft); }
  .calendar-day.level-1 { background: color-mix(in srgb,var(--ink) 20%,var(--paper)); }
  .calendar-day.level-2 { background: color-mix(in srgb,var(--ink) 40%,var(--paper)); }
  .calendar-day.level-3 { background: color-mix(in srgb,var(--ink) 65%,var(--paper)); }
  .calendar-day.level-4 { background: color-mix(in srgb,var(--ink) 90%,var(--paper)); }
  .calendar-day.future { background: transparent; }
  .calendar-footer,.calendar-legend { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .4rem; }
  .calendar-footer { margin-top: .65rem; }
  .calendar-legend { gap: .2rem; font-size: .6rem; }
  .empty-state { margin: 0; color: var(--muted); font-size: .85rem; }
  :global(body.study-room-open) { overflow: hidden; }
  :global(body[data-wallpaper='grid']) { background-image: linear-gradient(color-mix(in srgb,var(--rule-soft) 62%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--rule-soft) 62%,transparent) 1px,transparent 1px); background-size: 2rem 2rem; }
  :global(body[data-wallpaper='orbit']) { background-image: radial-gradient(circle at 92% 15%,transparent 0 12rem,color-mix(in srgb,var(--rule) 42%,transparent) 12.04rem 12.1rem,transparent 12.16rem),radial-gradient(circle at 92% 15%,transparent 0 7.5rem,color-mix(in srgb,var(--rule-soft) 72%,transparent) 7.54rem 7.6rem,transparent 7.66rem); }
  @media (max-width: 48rem) {
    .study-drawer { inset: 0; width: 100%; height: 100dvh; border-radius: 0; }
    .drawer-topbar { min-height: 5.2rem; padding: .85rem 1rem; gap: 1rem; }
    .drawer-topbar h2 { font-size: 1.5rem; }
    .room-kicker { font-size: .6rem; }
    .room-description { display: none; }
    .drawer-close { margin-left: auto; }
    .room-workspace { grid-template-columns: minmax(0,1fr); grid-template-rows: auto minmax(0,1fr); }
    .room-nav { flex-direction: row; gap: .25rem; padding: .35rem .75rem; }
    .room-nav button { flex: 1 1 0; justify-content: center; gap: .45rem; min-height: 2.9rem; padding: .5rem .2rem; }
    .room-nav svg { width: 1.05rem; height: 1.05rem; }
    .room-nav strong { font-size: .78rem; }
    .room-nav small { display: none; }
    .drawer-content { padding-inline: 1.2rem; }
    .drawer-content :global(.room-section) { padding-block: 1.4rem 1.6rem; }
    .section-heading h3 { font-size: 1.4rem; }
    .theme-preview { height: 5.3rem; padding: .6rem; }
    .preview-options { gap: .55rem; }
    .choice-label { font-size: .75rem; }
    .theme-preview b { font-size: .6rem; }
    .study-trigger { right: max(.38rem,env(safe-area-inset-right)); bottom: max(.38rem,env(safe-area-inset-bottom)); grid-template-columns: 2.25rem; width: 2.8rem; min-height: 2.8rem; padding: .14rem; place-content: center; }
    .study-trigger img { width: 2.25rem; height: 2.25rem; }
    .study-trigger span { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  }
  @media (max-width: 22rem) {
    .drawer-content { padding-inline: 1rem; }
    .room-nav { padding-inline: .45rem; }
    .room-nav button { gap: .3rem; }
    .theme-preview { height: 4.8rem; padding: .5rem; }
    .preview-options button { padding: .35rem; }
    .choice-label { font-size: .7rem; }
  }
  @media (prefers-reduced-motion: reduce) { .study-trigger,.study-backdrop,.study-drawer { transition-duration: .01ms; } }
  @media print { :global(body.study-room-open) { overflow: visible !important; } .study-trigger,.study-backdrop,.study-drawer { display: none !important; } }
</style>
