---
import { musicConfig } from '../../config/music';
import { withBase } from '../../lib/content';

const track = musicConfig.tracks[0] ?? null;
const selfHostedSource = track?.source.kind === 'self-hosted' ? track.source : null;
const initialStatus = '默认暂停，点击播放开始聆听。';
---

{track && (
  <div
    class="music-player"
    data-music-player
    data-state="idle"
    data-track-title={track.title}
    data-track-kind={track.source.kind}
    data-default-volume={String(musicConfig.defaultVolume)}
    data-volume-storage-key={musicConfig.volumeStorageKey}
    data-startup-timeout={String(musicConfig.startupTimeoutMs)}
    aria-label={`${track.title}音乐播放器`}
  >
  <div class="track-row">
    <button
      class="play-button"
      type="button"
      data-music-toggle
      aria-label={`播放${track.title}`}
      aria-pressed="false"
      aria-describedby="music-player-status"
    >
      <span class="control-symbol" aria-hidden="true"></span>
      <span data-control-label>播放</span>
    </button>

    <div class="track-copy">
      <p class="track-title">{track.title}</p>
    </div>

    <div class="waveform" aria-hidden="true">
      <span style="--bar: 0.62; --delay: -0.12s;"></span>
      <span style="--bar: 1; --delay: -0.44s;"></span>
      <span style="--bar: 0.78; --delay: -0.28s;"></span>
      <span style="--bar: 0.48; --delay: -0.62s;"></span>
      <span style="--bar: 0.86; --delay: -0.36s;"></span>
    </div>
  </div>

  <p class="track-description">{track.description}</p>

  {selfHostedSource && <>
    <div class="progress-row">
      <output data-elapsed>0:00</output>
      <input data-seek type="range" min="0" max="0" step="1" value="0" disabled aria-label="播放进度" />
      <output data-duration>--:--</output>
    </div>
    <div class="transport-row">
      <button type="button" data-previous aria-label="上一首">上一首</button>
      <button type="button" data-next aria-label="下一首">下一首</button>
      <select data-play-mode aria-label="播放模式">
        <option value="list">列表循环</option>
        <option value="one">单曲循环</option>
        <option value="shuffle">随机播放</option>
        <option value="order">顺序播放</option>
      </select>
      <button type="button" data-mute aria-pressed="false">静音</button>
    </div>
    <div class="player-options">
      <label>定时停止
        <select data-sleep aria-label="定时停止">
          <option value="0">关闭</option>
          <option value="15">15 分钟</option>
          <option value="30">30 分钟</option>
          <option value="60">60 分钟</option>
          <option value="end">本曲结束</option>
        </select>
      </label>
      <span data-sleep-status></span>
    </div>
    <details class="playlist">
      <summary>播放列表 · {musicConfig.tracks.filter(item => item.source.kind === 'self-hosted').length} 首</summary>
      <ol>
        {musicConfig.tracks.map((item, index) => item.source.kind === 'self-hosted' && <li>
          <button type="button" data-select-track={index} aria-current={index === 0 ? 'true' : undefined}>
            <span>{item.title}</span><small>{item.subtitle}</small>
          </button>
        </li>)}
      </ol>
    </details>
  </>}

  <div class="volume-row">
    <label for="study-music-volume">音量</label>
    <input
      id="study-music-volume"
      data-music-volume
      type="range"
      min="0"
      max="100"
      step="1"
      value={musicConfig.defaultVolume}
      aria-describedby="music-volume-value"
    />
    <output id="music-volume-value" data-music-volume-value for="study-music-volume">
      {musicConfig.defaultVolume}%
    </output>
  </div>

  <p class="player-status" id="music-player-status" data-music-status role="status" aria-live="polite">
    {initialStatus}
  </p>
  <p class="player-error" data-music-error role="alert" hidden></p>
  <p class="source-note">
    <span>{track.sourceNote}</span>
    {track.sourceUrl && (
      <>
        <span aria-hidden="true"> · </span>
        <a href={track.sourceUrl} target="_blank" rel="external noopener noreferrer">
          {track.sourceLabel ?? '来源页面'}
        </a>
      </>
    )}
  </p>
  {selfHostedSource && (
    <audio data-music-audio preload="none">
      <source src={withBase(selfHostedSource.src)} type={selfHostedSource.mimeType} />
    </audio>
  )}
  </div>
)}

<script>
  import { initializeMusic } from '../../features/study-room/music';
  initializeMusic();
</script>

<style>
  .progress-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem;
    gap: 0.4rem;
    align-items: center;
    margin-top: 0.7rem;
    font: 0.65rem var(--mono);
    font-variant-numeric: tabular-nums;
  }
  .progress-row input { width: 100%; min-width: 0; height: 2rem; accent-color: var(--ink); }
  .progress-row output:last-child { text-align: right; }
  .transport-row, .player-options { display: flex; align-items: center; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.5rem; }
  .transport-row button, select {
    min-height: 2.3rem; max-width: 100%; padding: 0.35rem 0.5rem;
    border: 1px solid var(--rule); border-radius: 0.5rem; background: var(--paper); color: var(--ink);
    font: inherit; font-size: 0.7rem; cursor: pointer;
  }
  .transport-row button:hover, .playlist button:hover { background: var(--rule); }
  .player-options { color: var(--muted); font-size: 0.66rem; justify-content: space-between; }
  .player-options label { display: flex; align-items: center; gap: 0.5rem; }
  .playlist { border-top: 1px solid var(--rule); margin-top: 0.8rem; font-size: 0.72rem; }
  .playlist summary { padding-block: 0.6rem; cursor: pointer; }
  .playlist ol { margin: 0; padding: 0; list-style: none; max-height: 13rem; overflow-y: auto; }
  .playlist button { width: 100%; padding: 0.65rem 0.4rem; border: 0; text-align: left; background: transparent; color: var(--ink); cursor: pointer; font: inherit; }
  .playlist button[aria-current='true'] { border-left: 2px solid var(--ink); font-weight: 650; background: var(--rule); }
  .playlist small { display: block; color: var(--muted); font-size: 0.6rem; font-weight: 400; }
  button:focus-visible, select:focus-visible, input:focus-visible, summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .music-player {
    min-width: 0;
    padding: 1.1rem;
    border-radius: 0.85rem;
    background: var(--paper-soft);
  }

  [data-music-audio] {
    display: none;
  }

  .track-row {
    display: grid;
    grid-template-columns: 3.35rem minmax(0, 1fr) 2.7rem;
    align-items: center;
    gap: 0.7rem;
  }

  .play-button {
    display: grid;
    grid-template-rows: 1fr auto;
    width: 3.35rem;
    min-height: 3.85rem;
    place-items: center;
    padding: 0.48rem 0.2rem 0.38rem;
    border: 0;
    border-radius: 0.75rem;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    font-size: 0.58rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .play-button:hover {
    background: var(--ink-soft);
  }

  .play-button:disabled {
    cursor: wait;
    opacity: 0.62;
  }

  .control-symbol {
    position: relative;
    display: block;
    width: 1rem;
    height: 1rem;
  }

  .control-symbol::before {
    position: absolute;
    top: 0.08rem;
    left: 0.25rem;
    width: 0;
    height: 0;
    border-top: 0.42rem solid transparent;
    border-bottom: 0.42rem solid transparent;
    border-left: 0.67rem solid currentColor;
    content: '';
  }

  [data-state='playing'] .control-symbol::before {
    top: 0.12rem;
    left: 0.17rem;
    width: 0.62rem;
    height: 0.76rem;
    border: 0;
    background: linear-gradient(90deg, currentColor 0 0.22rem, transparent 0.22rem 0.4rem, currentColor 0.4rem);
  }

  .track-copy {
    min-width: 0;
  }

  .track-kicker,
  .track-subtitle {
    margin: 0;
    color: var(--muted);
    font-family: var(--latin-sans), var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.11em;
    line-height: 1.4;
  }

  .track-title {
    margin: 0.13rem 0 0.08rem;
    font-family: var(--serif);
    font-size: 1.12rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .waveform {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.17rem;
    height: 2.25rem;
    padding-right: 0.05rem;
  }

  .waveform span {
    width: 0.18rem;
    height: calc(1.55rem * var(--bar));
    max-height: 100%;
    background: var(--rule);
    transform: scaleY(0.3);
    transform-origin: center;
  }

  [data-state='playing'] .waveform span {
    background: var(--ink-soft);
    animation: quiet-wave 1.16s ease-in-out infinite alternate;
    animation-delay: var(--delay);
  }

  .track-description {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.65;
  }

  .source-note a {
    color: inherit;
    text-decoration: none;
    border-radius: 0.25rem;
  }
  .source-note a:hover { color: var(--ink); }

  .volume-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 2.4rem;
    align-items: center;
    gap: 0.62rem;
    margin-top: 0.82rem;
  }

  .volume-row label,
  .volume-row output {
    color: var(--muted);
    font-family: var(--latin-sans), var(--sans);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .volume-row output {
    text-align: right;
  }

  .volume-row input {
    width: 100%;
    min-width: 0;
    height: 1.8rem;
    margin: 0;
    accent-color: var(--ink);
    cursor: pointer;
  }

  .player-status {
    min-height: 1.35rem;
    margin: 0.52rem 0 0;
    color: var(--ink-soft);
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .player-status::before {
    display: inline-block;
    width: 0.38rem;
    height: 0.38rem;
    margin-right: 0.4rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    content: '';
    vertical-align: 0.03rem;
  }

  [data-state='playing'] .player-status::before {
    background: currentColor;
  }

  .player-error {
    margin: 0.35rem 0 0;
    padding-left: 0.55rem;
    border-left: 2px solid currentColor;
    color: var(--ink);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .source-note {
    margin: 0.52rem 0 0;
    color: var(--muted);
    font-size: 0.58rem;
    line-height: 1.5;
  }

  @keyframes quiet-wave {
    from { transform: scaleY(0.28); }
    to { transform: scaleY(1); }
  }

  @media (max-width: 22rem) {
    .track-row {
      grid-template-columns: 3.1rem minmax(0, 1fr) 2.25rem;
      gap: 0.55rem;
    }

    .play-button {
      width: 3.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-state='playing'] .waveform span {
      animation: none;
      transform: scaleY(var(--bar));
    }
  }
</style>
