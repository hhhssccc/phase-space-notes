---
import EntryPreview from './EntryPreview.astro';
import { entryUrl, formatDate, readingMinutes, type ArticleEntry } from '../lib/content';
interface Props { entry: ArticleEntry; }
const { entry } = Astro.props;
---
<li class="illustrated-entry">
  <EntryPreview entry={entry} />
  <div>
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
    <h2><a href={entryUrl(entry)}>{entry.data.title}</a></h2>
    <p>{entry.data.description}</p>
    <span class="entry-meta">{entry.data.category} · {readingMinutes(entry.body || '')} 分钟</span>
  </div>
</li>
<style>
  .illustrated-entry { grid-template-columns: minmax(0, 12.5rem) minmax(0, 1fr); align-items: center; gap: 1.8rem; }
  .illustrated-entry:not(:has(img)) { grid-template-columns: 1fr; }
  time { display: block; margin-bottom: .4rem; }
  @media (max-width: 36rem) {
    .illustrated-entry { grid-template-columns: 6rem minmax(0, 1fr); gap: .35rem 1rem; align-items: start; }
    .illustrated-entry:has(img) > div { display: contents; }
    .illustrated-entry :global(img) { grid-row: 1 / 3; align-self: center; }
    .illustrated-entry:has(img) time, .illustrated-entry:has(img) h2 { grid-column: 2; }
    .illustrated-entry p, .illustrated-entry .entry-meta { grid-column: 1 / -1; }
    .illustrated-entry time { margin-bottom: 0; }
    .illustrated-entry h2 { font-size: 1.1rem; }
    .illustrated-entry p { font-size: .85rem; }
  }
  @media print { .illustrated-entry { grid-template-columns: 1fr; } }
</style>
