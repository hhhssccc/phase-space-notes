---
import { entryPreview } from '../lib/entry-preview';
import { withBase, type ArticleEntry } from '../lib/content';
interface Props { entry: ArticleEntry; compact?: boolean; }
const { entry, compact = false } = Astro.props;
const preview = await entryPreview(entry);
const variants = preview?.variants.filter(item => item.width <= 640);
const images = variants?.length ? variants : preview?.variants;
---
{preview && images && <img
  class:list={['entry-preview', { compact }]}
  src={withBase(images[0].src)}
  srcset={images.map(item => `${withBase(item.src)} ${item.width}w`).join(', ')}
  sizes={compact ? '96px' : '(max-width: 36rem) 96px, 200px'}
  width={preview.width} height={preview.height} alt="" aria-hidden="true"
  loading="lazy" decoding="async"
/>}
<style>
  .entry-preview { display: block; width: 100%; aspect-ratio: 8 / 5; height: auto; object-fit: contain; border-radius: .25rem; background: #fff; }
  .compact { width: 6rem; }
  @media print { .entry-preview { display: none; } }
</style>
