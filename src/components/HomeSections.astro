---
import EntryPreview from './EntryPreview.astro';
import { entryUrl, formatDate, readingMinutes, withBase, type ArticleEntry } from '../lib/content';

interface Props { entries: ArticleEntry[]; leadId: string; }
const { entries, leadId } = Astro.props;
const remaining = entries.filter(entry => entry.id !== leadId);
const featured = remaining.filter(entry => entry.data.type === 'essay' && entry.data.featured).slice(0, 3);
const labs = remaining.filter(entry => entry.data.type === 'visualization').slice(0, 2);
const notes = remaining.filter(entry => entry.data.type === 'note').slice(0, 4);
const reflections = remaining.filter(entry => entry.data.type === 'reflection').slice(0, 3);

// Only the home-page display is shortened; the published title remains the
// accessible name and the article's source title is untouched.
function noteTitle(entry: ArticleEntry) {
  const series = entry.data.title.match(/《([^》]+)》.*?(?:听课笔记|速通笔记)\s*(\d+)\s*[：:]\s*(.+)$/);
  return series
    ? { label: `${series[1]} · 笔记 ${series[2]}`, title: series[3] }
    : { label: entry.data.category, title: entry.data.title };
}
function labTitle(entry: ArticleEntry) {
  const parts = entry.data.title.match(/^([^：:]+)[：:]\s*(.+)$/);
  return parts
    ? { label: parts[1], title: parts[2] }
    : { label: entry.data.category, title: entry.data.title };
}
---

<div class:list={['home-sections', { 'without-sidebar': !notes.length && !reflections.length }]}>
  <div class="story-flow">
    {featured.length > 0 && (
      <section class="featured-section" aria-labelledby="featured-title">
        <header class="stream-heading"><h2 id="featured-title"><a href={withBase('/articles/')}>精选文章</a></h2></header>
        <ol class="illustrated-grid feature-grid">
          {featured.map(entry => (
            <li class="illustrated-item">
              <a class="story-link feature-link" href={entryUrl(entry)} aria-label={entry.data.title}>
                <span class="story-visual"><EntryPreview entry={entry} sizes="(max-width: 40rem) calc(100vw - 40px), (max-width: 64rem) 44vw, 360px" /></span>
                <div class="story-copy">
                  <span class="stream-meta"><span class="entry-subject">{entry.data.category}</span><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, false)}</time><span>{readingMinutes(entry.body || '')} 分钟</span></span>
                  <h3>{entry.data.title}</h3>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {labs.length > 0 && (
      <section class="lab-section" aria-labelledby="home-lab-title">
        <header class="stream-heading"><h2 id="home-lab-title"><a href={withBase('/lab/')}>演算室</a></h2></header>
        <ol class="illustrated-grid lab-grid">
          {labs.map(entry => {
            const display = labTitle(entry);
            return (
              <li class="illustrated-item">
                <a class="story-link lab-link" href={entryUrl(entry)} aria-label={entry.data.title}>
                  <span class="story-visual"><EntryPreview entry={entry} sizes="(max-width: 40rem) calc(100vw - 40px), (max-width: 64rem) 44vw, 360px" /></span>
                  <div class="story-copy">
                    <span class="stream-meta"><span class="entry-subject">{display.label}</span><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, false)}</time></span>
                    <h3 aria-label={entry.data.title}>{display.title}</h3>
                    <p>{entry.data.description}</p>
                  </div>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    )}
  </div>

  {(notes.length > 0 || reflections.length > 0) && (
    <aside class="journal-sidebar" aria-label="笔记与杂感">
      {notes.length > 0 && (
        <section class="notes-section" aria-labelledby="home-notes-title">
          <header class="sidebar-heading"><h2 id="home-notes-title"><a href={withBase('/notes/')}>近期笔记</a></h2></header>
          <ol class="notes-index">
            {notes.map(entry => {
              const display = noteTitle(entry);
              return (
                <li>
                  <a class="note-link" href={entryUrl(entry)} aria-label={entry.data.title}>
                    <div class="note-copy">
                      <span class="note-meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, false)}</time><span>{display.label}</span></span>
                      <h3 aria-label={entry.data.title}>{display.title}</h3>
                    </div>
                    <span class="note-visual"><EntryPreview entry={entry} sizes="80px" /></span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      )}

      {reflections.length > 0 && (
        <section class="reflections-section" aria-labelledby="home-reflections-title">
          <header class="sidebar-heading"><h2 id="home-reflections-title"><a href={withBase('/reflections/')}>杂感</a></h2></header>
          <ol class="reflection-index">
            {reflections.map(entry => (
              <li>
                <a class="reflection-link" href={entryUrl(entry)} aria-label={entry.data.title}>
                  <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, false)}</time>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}
    </aside>
  )}
</div>

<style>
  .home-sections {
    display: grid;
    grid-template-columns: var(--journal-columns, minmax(0, 2.28fr) minmax(0, 1fr));
    column-gap: var(--journal-gutter, clamp(2rem, 4.6vw, 4.2rem));
    align-items: start;
    min-width: 0;
    padding-top: 1.45rem;
    border-top: 1px solid var(--rule-soft);
  }
  .home-sections.without-sidebar { grid-template-columns: 1fr; }
  .home-sections a { text-decoration: none; }
  .home-sections time { font-family: var(--latin-sans), var(--sans); font-variant-numeric: tabular-nums; }
  .home-sections h3 { margin: 0; color: var(--ink); font-family: var(--serif); font-weight: 650; line-height: 1.55; text-wrap: pretty; }
  .home-sections ol { margin: 0; padding: 0; list-style: none; }
  .home-sections li, .home-sections section, .home-sections a > div, .story-flow { min-width: 0; }
  .stream-heading { margin-bottom: 1.6rem; }
  .stream-heading h2 { margin: 0; font-family: var(--serif); font-size: 1.42rem; font-weight: 650; line-height: 1.4; }
  .stream-heading a:hover, .stream-heading a:focus-visible, .sidebar-heading a:hover, .sidebar-heading a:focus-visible { text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: .22em; }
  .stream-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: .7rem; color: var(--muted); font-size: .66rem; line-height: 1.6; }
  .entry-subject { color: var(--muted); font-size: .65rem; font-weight: 600; letter-spacing: .08em; }
  #featured-title { scroll-margin-top: 6rem; }
  .illustrated-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.7rem 2.2rem; }
  .illustrated-item { display: grid; grid-template-rows: subgrid; grid-row: span 2; row-gap: 0; }
  .story-link { display: grid; grid-template-rows: subgrid; grid-row: span 2; row-gap: 0; }
  .story-visual { display: block; overflow: hidden; margin-bottom: 1.15rem; background: #fff; }
  .story-visual :global(.entry-preview), .note-visual :global(.entry-preview) { border-radius: 0; }
  .story-copy h3 { margin-top: .65rem; font-size: clamp(1.3rem, 1.8vw, 1.6rem); }
  .story-link:hover h3, .story-link:focus-visible h3, .note-link:hover h3, .note-link:focus-visible h3, .reflection-link:hover h3, .reflection-link:focus-visible h3 { text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: .22em; }
  .lab-section { margin-top: 3.3rem; padding-top: 1.9rem; border-top: 1px solid var(--rule-soft); }
  .lab-link h3 { font-size: clamp(1.25rem, 1.65vw, 1.45rem); }
  .lab-link p { margin: .75rem 0 0; color: var(--ink-soft); font-size: .79rem; line-height: 1.9; }
  .journal-sidebar { min-width: 0; padding-inline-start: var(--journal-gutter, clamp(2rem, 4.6vw, 4.2rem)); border-left: 1px solid var(--rule-soft); }
  .sidebar-heading { margin-bottom: .65rem; }
  .sidebar-heading h2 { margin: 0; font-family: var(--sans); font-size: 1.18rem; font-weight: 700; line-height: 1.7; }
  .note-link { display: grid; grid-template-columns: minmax(0, 1fr) 5rem; align-items: start; gap: .75rem; padding-block: 1.05rem; }
  .note-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: .15rem .45rem; margin-bottom: .35rem; color: var(--muted); font-size: .6rem; line-height: 1.65; }
  .note-meta time { flex-shrink: 0; font-family: var(--latin-sans), var(--sans); font-variant-numeric: tabular-nums; }
  .note-link h3 { font-size: .97rem; line-height: 1.65; }
  .note-visual { display: block; width: 5rem; overflow: hidden; background: #fff; }
  .reflections-section { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .reflection-link { display: block; padding-block: .95rem; }
  .reflection-link time { display: block; margin-bottom: .35rem; color: var(--muted); font-family: var(--latin-sans), var(--sans); font-size: .64rem; font-variant-numeric: tabular-nums; line-height: 1.7; }
  .reflection-link h3 { font-size: 1.02rem; line-height: 1.7; }
  .reflection-link p { margin: .6rem 0 0; color: var(--muted); font-size: .76rem; line-height: 1.9; }

  @media (min-width: 40.001rem) {
    .feature-grid:has(> li:nth-child(3):last-child) > li:first-child { display: block; grid-column: 1 / -1; grid-row: auto; }
    .feature-grid:has(> li:nth-child(3):last-child) > li:first-child .feature-link {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      column-gap: clamp(1.5rem, 2.5vw, 2.2rem);
      align-items: center;
    }
    .feature-grid:has(> li:nth-child(3):last-child) > li:first-child .story-visual { margin: 0; }
  }
  @media (max-width: 72rem) {
    .illustrated-grid { column-gap: 1.5rem; }
    .note-link { gap: .65rem; }
    .note-link h3 { font-size: .93rem; }
  }
  @media (max-width: 64rem) {
    .home-sections { display: block; padding-top: 1.6rem; }
    .stream-heading { margin-bottom: 1.5rem; }
    .illustrated-grid { gap: 2.5rem 2rem; }
    .story-copy h3 { font-size: 1.5rem; }
    .lab-link h3 { font-size: 1.4rem; }
    .lab-link p { font-size: .83rem; }
    .lab-section { margin-top: 2.8rem; padding-top: 1.8rem; }
    .journal-sidebar { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 3rem; margin-top: 3rem; padding: 1.8rem 0 0; border-top: 1px solid var(--rule); border-left: 0; }
    .note-link h3 { font-size: 1.02rem; }
    .reflections-section { margin: 0; padding: 0 0 0 2rem; border-top: 0; border-left: 1px solid var(--rule-soft); }
    .reflection-link h3 { font-size: 1.08rem; }
  }
  @media (max-width: 40rem) {
    .home-sections { padding-top: 1.35rem; }
    .stream-heading { margin-bottom: 1.65rem; }
    .stream-heading h2 { font-size: 1.3rem; }
    .illustrated-grid { grid-template-columns: 1fr; row-gap: 3rem; }
    .story-visual { margin-bottom: 1.55rem; }
    .story-copy h3 { margin-top: .8rem; font-size: 1.45rem; line-height: 1.65; }
    .lab-link h3 { font-size: 1.35rem; }
    .lab-section { margin-top: 3rem; padding-top: 1.85rem; }
    .lab-link p { margin-top: .85rem; font-size: .81rem; }
    .journal-sidebar { grid-template-columns: 1fr; gap: 2.6rem; margin-top: 3rem; padding-top: 1.85rem; }
    .sidebar-heading { margin-bottom: 1rem; }
    .note-link { grid-template-columns: minmax(0, 1fr) 5rem; gap: 1.1rem; padding-block: 1.25rem; }
    .note-link h3 { font-size: 1.08rem; line-height: 1.75; }
    .note-meta { gap: .25rem .6rem; margin-bottom: .55rem; font-size: .65rem; line-height: 1.75; }
    .reflections-section { padding: 1.85rem 0 0; border-top: 1px solid var(--rule); border-left: 0; }
    .reflection-link { padding-block: 1.2rem; }
    .reflection-link time { margin-bottom: .55rem; }
    .reflection-link h3 { font-size: 1.12rem; }
    .reflection-link p { margin-top: .75rem; }
  }
  @media (max-width: 22rem) {
    .story-copy h3 { font-size: 1.35rem; }
    .lab-link h3 { font-size: 1.28rem; }
  }
  @media print {
    .home-sections, .illustrated-grid, .illustrated-item, .story-link, .journal-sidebar { display: block; }
    .illustrated-item { margin-block: 1rem; }
    .story-visual, .note-visual { display: none; }
    .lab-section { margin-top: 2rem; padding-top: 1rem; }
    .journal-sidebar { margin-top: 2rem; padding: 1rem 0 0; border-left: 0; }
    .note-link { display: block; }
    .reflections-section { margin-top: 1.5rem; padding: 1rem 0 0; border-left: 0; }
  }
</style>
