---
import { articleLabs, labs, type LabDefinition } from '../features/physics-lab/registry';
import { groverSvg } from '../features/physics-lab/plots/grover';
import { gasSvg } from '../features/physics-lab/plots/gas';
import InlineMarkup from './InlineMarkup.astro';
import { renderInlineMarkup } from '../lib/inline-markup';
import '../features/physics-lab/styles.css';
const { id } = Astro.props as { id: string };
const kind = articleLabs[id];
const definition: LabDefinition | undefined = kind ? labs[kind] : undefined;
const plots = { grover: groverSvg, gas: gasSvg };
const values = definition?.controls.map(control => control.value) ?? [];
---
{definition && <section class="physics-lab" data-physics-lab={kind} aria-labelledby="physics-lab-title">
  <p class="eyebrow">文后实验 · 阅读辅助</p>
  <h2 id="physics-lab-title">{definition.title}</h2>
  <p>{definition.description}</p>
  <p class="lab-equation"><InlineMarkup html={await renderInlineMarkup(definition.formula)} /></p>
  <div class="lab-static" data-static-plot>
    <div class="lab-plot" set:html={plots[kind](values[0], values[1])} />
    <p class="lab-caption">{definition.staticCaption}</p>
  </div>
  <button type="button" class="lab-start print-hidden" data-lab-start>打开互动演示</button>
  <div class="lab-interactive print-hidden" data-lab-interactive hidden>
    <div class="lab-controls">
      {definition.controls.map(control => <label>{control.label}{' '}
        {control.options ? <select {...{ [`data-lab-${control.key}`]: '' }}>
          {control.options.map(value => <option value={value} selected={value === control.value}>{value}</option>)}
        </select> : <>
          <output {...{ [`data-${control.output}`]: '' }}>{control.display}</output>
          <input {...{ [`data-lab-${control.key}`]: '' }} type="range" min={control.min} max={control.max} step={control.step} value={control.value} />
        </>}
      </label>)}
    </div>
    <div class="lab-plot" data-live-plot></div>
    <p class="lab-result" data-lab-result role="status" aria-live="polite"></p>
    <button type="button" class="text-control" data-lab-reset>恢复初始值</button>
  </div>
  <p class="lab-caption">{definition.caption}</p>
  <p class="lab-source">模型参考：<a href={definition.source.href}>{definition.source.label}</a></p>
</section>}
<script>import '../features/physics-lab/entry';</script>
