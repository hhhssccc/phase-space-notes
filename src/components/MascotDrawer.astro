---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { byNewest, entryUrl } from '../lib/content';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort(byNewest);
const essays = entries.filter((entry) => entry.data.type === 'essay');
const notes = entries.filter((entry) => entry.data.type === 'note');
const latest = entries.slice(0, 2);
---

<button
  class="mascot-trigger"
  type="button"
  data-drawer-open
  aria-controls="study-drawer"
  aria-expanded="false"
>
  <img src={siteConfig.mascot.reading} width="373" height="520" alt="" />
  <span>书房</span>
</button>

<div class="drawer-backdrop" data-drawer-backdrop hidden></div>
<aside class="study-drawer" id="study-drawer" aria-labelledby="study-title" aria-hidden="true" tabindex="-1">
  <header>
    <div>
      <p class="eyebrow">READING ROOM</p>
      <h2 id="study-title">书房</h2>
    </div>
    <button type="button" class="drawer-close" data-drawer-close aria-label="关闭书房">关闭</button>
  </header>

  <p class="drawer-intro">趣味功能停留在这里；文章背景始终保持纯净纸面。</p>

  <section class="drawer-section">
    <h3>主题</h3>
    <div class="segmented" role="group" aria-label="主题设置">
      <button type="button" data-set-theme="light">浅色</button>
      <button type="button" data-set-theme="dark">深色</button>
      <button type="button" data-set-theme="system">跟随系统</button>
    </div>
  </section>

  {siteConfig.features.wallpaper && (
    <section class="drawer-section wallpaper-controls">
      <h3>首页纸面</h3>
      <div class="segmented" role="group" aria-label="首页纸面纹理">
        <button type="button" data-set-wallpaper="plain">纯纸</button>
        <button type="button" data-set-wallpaper="grid">方格</button>
        <button type="button" data-set-wallpaper="wave">波包</button>
      </div>
      <p>只影响首页与书房，不进入正文。</p>
    </section>
  )}

  <section class="drawer-section">
    <h3>最近动态</h3>
    <ul class="drawer-updates">
      {latest.map((entry) => <li><a href={entryUrl(entry)}>{entry.data.title}</a></li>)}
    </ul>
  </section>

  {siteConfig.features.stats && (
    <section class="drawer-section">
      <h3>站点统计</h3>
      <dl class="site-stats">
        <div><dt>长文</dt><dd>{essays.length}</dd></div>
        <div><dt>笔记</dt><dd>{notes.length}</dd></div>
        <div><dt>主题</dt><dd>{new Set(entries.flatMap((entry) => entry.data.tags)).size}</dd></div>
      </dl>
    </section>
  )}

  <figure class="drawer-mascot">
    <img src={siteConfig.mascot.reading} width="373" height="520" alt={`${siteConfig.mascot.name}正在阅读笔记`} />
    <figcaption>{siteConfig.mascot.name} · 阅读中</figcaption>
  </figure>
</aside>
