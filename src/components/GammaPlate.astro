---
/**
 * An original mathematical cover, evaluated at build time. No canvas, external
 * artwork, or client script is involved. The height is log(1 + |Gamma(z)|).
 *
 * Gamma is meromorphic with simple poles at 0, -1, -2, ... (DLMF 5.2).
 * The reflection identity is also discussed in content/special-functions.md.
 * https://dlmf.nist.gov/5.2  https://dlmf.nist.gov/5.5#E3
 */
interface Props {
  class?: string;
  idPrefix?: string;
  decorative?: boolean;
}

const { class: className, idPrefix = 'gamma-plate', decorative = false } = Astro.props;
const paint = (name: string) => `url(#${idPrefix}-${name})`;

// Lanczos (g = 7), evaluated in logarithmic modulus. Reflection moves the
// left half-plane into Re(z) >= 1/2 and avoids a complex logarithm branch cut.
const coefficients = [
  0.99999999999980993,
  676.5203681218851,
  -1259.1392167224028,
  771.32342877765313,
  -176.61502916214059,
  12.507343278686905,
  -0.13857109526572012,
  9.9843695780195716e-6,
  1.5056327351493116e-7,
];

function logAbsGamma(x: number, y: number): number {
  if (x < 0.5) {
    const sineModulus = Math.hypot(Math.sin(Math.PI * x), Math.sinh(Math.PI * y));
    return Math.log(Math.PI) - Math.log(sineModulus) - logAbsGamma(1 - x, -y);
  }

  let real = coefficients[0];
  let imaginary = 0;
  for (let k = 1; k < coefficients.length; k += 1) {
    const denominatorReal = x + k - 1;
    const denominator = denominatorReal ** 2 + y ** 2;
    real += coefficients[k] * denominatorReal / denominator;
    imaginary -= coefficients[k] * y / denominator;
  }
  const tReal = x + 6.5;
  return 0.5 * Math.log(2 * Math.PI)
    + (x - 0.5) * Math.log(Math.hypot(tReal, y))
    - y * Math.atan2(y, tReal) - tReal
    + Math.log(Math.hypot(real, imaginary));
}

const ceiling = 3.1;
function height(x: number, y: number): number {
  // Do not evaluate Gamma at a pole. The finite plotting ceiling represents
  // the surface cut by a horizontal plane; it is not a finite pole value.
  if (x <= 0 && Math.abs(y) < 1e-10 && Math.abs(x - Math.round(x)) < 1e-10) return ceiling;
  const logarithm = logAbsGamma(x, y);
  return Math.min(ceiling, logarithm > 20 ? logarithm : Math.log1p(Math.exp(logarithm)));
}

type Point = { x: number; y: number };
const xMin = -3.45;
const xMax = 3.1;
const yMin = -2.45;
const yMax = 2.45;
const uMin = xMin + yMin;
const uMax = xMax + yMax;
const vMin = xMin - yMax;
const vMax = xMax - yMin;

// u = Re(z) + Im(z) points away from the viewer. Painting successive strips
// gives the mesh real occlusion; back lines do not show through the peaks.
function project(u: number, v: number): Point {
  const x = (u + v) / 2;
  const y = (u - v) / 2;
  return { x: 920 + 142 * v, y: 495 - 32 * u - 104 * height(x, y) };
}

const fixed = (value: number) => value.toFixed(1);
const coordinate = (point: Point) => `${fixed(point.x)},${fixed(point.y)}`;
const path = (points: Point[]) => points.map((point, index) => `${index ? 'L' : 'M'}${coordinate(point)}`).join('');
const unique = (values: number[]) => [...new Set(values.map((value) => Number(value.toFixed(5))))].sort((a, b) => a - b);

// Finer samples near each pole retain the narrow throats without increasing
// the mesh density over the whole picture.
const poleSamples = [-3, -2, -1, 0].flatMap((pole) => [
  -0.1, -0.045, -0.022, -0.01, -0.004, 0, 0.004, 0.01, 0.022, 0.045, 0.1,
].map((offset) => pole + offset));
const depths = unique([
  ...Array.from({ length: 77 }, (_, index) => uMin + (uMax - uMin) * index / 76),
  ...poleSamples,
]).reverse();
const samples = unique([
  ...Array.from({ length: 104 }, (_, index) => vMin + (vMax - vMin) * index / 103),
  ...poleSamples,
]);
const realLines = unique([
  ...Array.from({ length: 53 }, (_, index) => xMin + (xMax - xMin) * index / 52),
  ...[-3, -2, -1, 0].flatMap((pole) => [-0.04, 0, 0.04].map((offset) => pole + offset)),
]);
const imaginaryLines = unique([
  ...Array.from({ length: 43 }, (_, index) => yMin + (yMax - yMin) * index / 42),
  -0.075, -0.04, -0.018, 0, 0.018, 0.04, 0.075,
]);

function bounds(u: number): [number, number] {
  return [Math.max(2 * xMin - u, u - 2 * yMax), Math.min(2 * xMax - u, u - 2 * yMin)];
}

// Subpixel simplification removes redundant points on quiet areas of the
// surface. The maximum deviation is 0.22 viewBox units, below one screen pixel.
function simplify(points: Point[], tolerance = 0.22): Point[] {
  if (points.length <= 2) return points;
  const first = points[0];
  const last = points[points.length - 1];
  const dx = last.x - first.x;
  const dy = last.y - first.y;
  const length = Math.hypot(dx, dy) || 1;
  let largest = 0;
  let split = 0;
  for (let index = 1; index < points.length - 1; index += 1) {
    const distance = Math.abs(dy * (points[index].x - first.x) - dx * (points[index].y - first.y)) / length;
    if (distance > largest) {
      largest = distance;
      split = index;
    }
  }
  if (largest <= tolerance) return [first, last];
  return [...simplify(points.slice(0, split + 1), tolerance).slice(0, -1), ...simplify(points.slice(split), tolerance)];
}

function row(u: number): Point[] {
  const [left, right] = bounds(u);
  return simplify([left, ...samples.filter((v) => v > left && v < right), right].map((v) => project(u, v)));
}

const rows = depths.map(row);
const bands = depths.slice(1).map((u, index) => {
  const previous = depths[index];
  const currentRow = rows[index + 1];
  const previousRow = rows[index];
  const [left, right] = bounds(u);
  const [oldLeft, oldRight] = bounds(previous);
  const meridians = [
    ...realLines.map((x) => [2 * x - previous, 2 * x - u]),
    ...imaginaryLines.map((y) => [previous - 2 * y, u - 2 * y]),
  ].filter(([before, after]) => before >= oldLeft && before <= oldRight && after >= left && after <= right)
    .map(([before, after]) => `M${coordinate(project(previous, before))}L${coordinate(project(u, after))}`).join('');
  return {
    fill: `${path(previousRow)}${path([...currentRow].reverse()).replace(/^M/, 'L')}Z`,
    mesh: meridians,
    delay: `${Math.round(index * 19)}ms`,
  };
});

// For every screen abscissa, the smallest projected ordinate is the visible
// upper silhouette. Retain only the part belonging to the pole at z = 0.
// The animated stroke therefore follows the plotted surface, with no hidden
// lines drawn over a foreground fold.
let connected = false;
const mainSilhouette = Array.from({ length: 181 }, (_, index) => -0.68 + 1.36 * index / 180)
  .map((v) => {
    let best: { point: Point; u: number } | undefined;
    for (const u of depths) {
      const [left, right] = bounds(u);
      if (v < left || v > right) continue;
      const point = project(u, v);
      if (!best || point.y < best.point.y) best = { point, u };
    }
    if (!best || best.u + v <= -1 || Math.hypot((best.u + v) / 2, (best.u - v) / 2) > 0.95) return undefined;
    return best.point;
  })
  .map((point) => {
    if (!point) {
      connected = false;
      return '';
    }
    const command = `${connected ? 'L' : 'M'}${coordinate(point)}`;
    connected = true;
    return command;
  }).join('');

const nearEdges = [
  Array.from({ length: 90 }, (_, index) => {
    const x = xMin + (xMax - xMin) * index / 89;
    return project(x + yMin, x - yMin);
  }),
  Array.from({ length: 90 }, (_, index) => {
    const y = yMax - (yMax - yMin) * index / 89;
    return project(xMin + y, xMin - y);
  }),
];
const title = 'Gamma 函数的复平面模曲面';
const description = '平面坐标为复数 z 的实部与虚部，高度为 ln(1 + |Γ(z)|)。图中四峰从右向左依次对应极点 z = 0、−1、−2、−3；极点向上发散，图中在高度 3.1 截断。色彩为光照示意。';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1600 672"
  width="1600"
  height="672"
  class:list={['gamma-plate', className]}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-labelledby={decorative ? undefined : `${idPrefix}-title ${idPrefix}-description`}
  focusable="false"
>
  <title id={`${idPrefix}-title`}>{title}</title>
  <desc id={`${idPrefix}-description`}>{description}</desc>
  <defs>
    <linearGradient id={`${idPrefix}-background`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#10162f" />
      <stop offset="0.54" stop-color="#121d38" />
      <stop offset="1" stop-color="#0b142c" />
    </linearGradient>
    <radialGradient id={`${idPrefix}-atmosphere`} cx="58%" cy="41%" r="65%">
      <stop offset="0" stop-color="#455e79" stop-opacity="0.22" />
      <stop offset="1" stop-color="#15203b" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`${idPrefix}-surface`} gradientUnits="userSpaceOnUse" x1="500" y1="150" x2="1000" y2="660">
      <stop offset="0" stop-color="#c7a58b" />
      <stop offset="0.24" stop-color="#a96e57" />
      <stop offset="0.46" stop-color="#6a5a63" />
      <stop offset="0.7" stop-color="#356b7b" />
      <stop offset="1" stop-color="#164358" />
    </linearGradient>
    <linearGradient id={`${idPrefix}-ink`} gradientUnits="userSpaceOnUse" x1="550" y1="140" x2="1060" y2="650">
      <stop offset="0" stop-color="#fff2d6" />
      <stop offset="0.24" stop-color="#ffceaa" />
      <stop offset="0.52" stop-color="#e4b299" />
      <stop offset="0.78" stop-color="#a1d7dc" />
      <stop offset="1" stop-color="#73b6ca" />
    </linearGradient>
    <linearGradient id={`${idPrefix}-edge`} gradientUnits="userSpaceOnUse" x1="150" y1="440" x2="1510" y2="650">
      <stop offset="0" stop-color="#80c5cf" stop-opacity="0.15" />
      <stop offset="0.5" stop-color="#a9d2d2" stop-opacity="0.8" />
      <stop offset="1" stop-color="#83adbb" stop-opacity="0.15" />
    </linearGradient>
  </defs>

  <rect width="1600" height="672" fill={paint('background')} />
  <rect width="1600" height="672" fill={paint('atmosphere')} />

  <g class="gamma-surface" stroke-linejoin="round" stroke-linecap="round">
    {bands.map((band) => (
      <>
        <path d={band.fill} fill={paint('surface')} stroke={paint('surface')} stroke-width="0.9" />
        <path class="gamma-wire" style={`--etch-delay: ${band.delay}`} d={band.mesh} fill="none" stroke={paint('ink')} stroke-width="1.4" />
      </>
    ))}
    <path d={nearEdges.map(path).join('')} fill="none" stroke={paint('edge')} stroke-width="1.5" />
    <path class="gamma-contour" d={mainSilhouette} fill="none" stroke="#fff2d6" stroke-width="5.2" pathLength="1" stroke-dasharray="1" />
  </g>

  <g class="gamma-notation" fill="#eee5d3">
    <text x="100" y="168" class="gamma-name">Γ(z)</text>
    <text x="103" y="205" class="gamma-height">ln(1 + |Γ(z)|)</text>
    <text x="1510" y="150" text-anchor="end" class="gamma-domain">z ∈ ℂ</text>
    <path class="gamma-pole-guide" d="M926,171L985,131H1050" fill="none" stroke="#eee5d3" stroke-opacity="0.7" stroke-width="1.2" />
    <text x="1066" y="142" class="gamma-pole"><tspan font-style="italic">z</tspan> = 0</text>
  </g>
</svg>

<style>
  .gamma-plate {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    aspect-ratio: 50 / 21;
    overflow: hidden;
    isolation: isolate;
  }

  .gamma-wire {
    opacity: 0.8;
    animation: gamma-etch 1.05s ease-out both;
    animation-delay: var(--etch-delay);
  }

  .gamma-contour {
    opacity: 0;
    animation: gamma-trace 2.7s ease-in-out both;
    animation-delay: 0.25s;
  }

  .gamma-notation {
    font-family: var(--serif, 'Source Serif 4', Georgia, serif);
    pointer-events: none;
  }

  .gamma-name {
    font-size: 60px;
    font-style: italic;
    letter-spacing: -1.5px;
  }

  .gamma-height {
    font-size: 27px;
    letter-spacing: 0.6px;
    opacity: 0.66;
  }

  .gamma-domain {
    font-size: 34px;
    opacity: 0.65;
  }

  .gamma-pole {
    font-size: 34px;
  }

  @keyframes gamma-etch {
    0%, 100% { opacity: 0.8; }
    38% { opacity: 1; }
  }

  @keyframes gamma-trace {
    0% { opacity: 0; stroke-dashoffset: 1; }
    12% { opacity: 1; }
    76% { opacity: 1; stroke-dashoffset: 0; }
    100% { opacity: 0; stroke-dashoffset: 0; }
  }

  @media (max-width: 48rem) {
    /* One surface and one viewBox: the phone composition is translated,
       never stretched, and retains all four poles at the same scale. */
    .gamma-surface { transform: translateY(-64px); }
    .gamma-name { transform: translateY(-65px); font-size: 64px; }
    .gamma-height, .gamma-domain, .gamma-pole, .gamma-pole-guide { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gamma-wire, .gamma-contour { animation: none; }
  }

  @media print {
    .gamma-plate { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .gamma-wire, .gamma-contour { animation: none; }
  }
</style>
