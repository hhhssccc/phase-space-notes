---
import { createGammaPoster } from '../features/gamma-surface/poster';

interface Props {
  class?: string;
  idPrefix?: string;
  decorative?: boolean;
}
const { class: className, idPrefix = 'gamma-surface' } = Astro.props;
const [poster, mobilePoster] = await Promise.all([createGammaPoster(), createGammaPoster(true)]);
const presets = [
  { name: 'oblique', label: '斜视', icon: 'M12 3 21 8v9l-9 5-9-5V8l9-5Zm0 9 9-4M12 12 3 8m9 4v10' },
  { name: 'top', label: '俯视', icon: 'M4 4h16v16H4zM4 12h16M12 4v16' },
  { name: 'side', label: '侧视', icon: 'M3 20h18M4 19l4-7 3 4 4-12 5 15' },
];
---

<div class:list={['gamma-plate', className]} data-gamma-viewer role="group" aria-label="Gamma 函数曲面" aria-describedby={`${idPrefix}-help`}>
  <div class="gamma-scene" data-gamma-scene>
  <picture class="gamma-poster" data-gamma-fallback>
    <source media="screen and (max-width: 48rem)" srcset={mobilePoster} />
    <img src={poster} width="1600" height="672" alt="灰白釉面的 Gamma 函数曲面与四个高峰" decoding="sync" fetchpriority="high" />
  </picture>
  <canvas class="gamma-canvas" data-gamma-canvas tabindex="0" aria-label="Gamma 曲面，可用方向键旋转"></canvas>
  <span class="gamma-mark" aria-hidden="true">Γ(z)</span>
  <span class="gamma-hint" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m8 13-2-2a2 2 0 0 0-3 2l5 7h9l4-8a2 2 0 0 0-3-2l-1 2V5a2 2 0 0 0-4 0v6-8a2 2 0 0 0-4 0v10" /></svg>
    拖动旋转
  </span>
  </div>
  <div class="gamma-controls" role="toolbar" aria-label="曲面视角">
    {presets.map((preset) => (
      <button type="button" data-gamma-preset={preset.name} aria-pressed={preset.name === 'oblique' ? 'true' : 'false'} disabled>
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={preset.icon} /></svg>
        <span>{preset.label}</span>
      </button>
    ))}
    <button type="button" data-gamma-reset aria-label="恢复默认视角" disabled>
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11a9 9 0 1 1 2 7M3 5v6h6" /></svg>
      <span>复位</span>
    </button>
  </div>
  <span class="gamma-accessible" id={`${idPrefix}-help`}>可拖动旋转，使用视角按钮切换斜视、俯视和侧视。极点附近使用有限截高。</span>
  <span class="gamma-accessible" data-gamma-status role="status" aria-live="polite"></span>
</div>

<script>
  import '../features/gamma-surface/viewer';
</script>

<style>
  .gamma-plate {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    isolation: isolate;
    color: #ebe9e4;
    background: radial-gradient(ellipse at 53% 39%, #2a2c30 0%, #191b1f 37%, #0d0f12 78%);
  }
  .gamma-scene { position: relative; aspect-ratio: 50 / 21; overflow: hidden; }
  .gamma-poster, .gamma-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .gamma-poster img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .gamma-canvas { opacity: 0; cursor: grab; touch-action: pan-y pinch-zoom; outline-offset: -4px; }
  .gamma-canvas:focus-visible { outline: 2px solid #cbc7bd; }
  [data-gamma-ready='true'] .gamma-canvas { opacity: 1; }
  [data-gamma-ready='true'] .gamma-poster { visibility: hidden; }
  [data-gamma-dragging='true'] .gamma-canvas { cursor: grabbing; }
  .gamma-mark { position: absolute; top: clamp(6.2rem, 8vw, 8rem); left: clamp(1.5rem, 6.7vw, 8rem); font-family: var(--serif, Georgia, serif); font-size: clamp(1.25rem, 2.6vw, 2.7rem); font-style: italic; line-height: 1; opacity: 0.8; pointer-events: none; }
  .gamma-hint { position: absolute; bottom: 1.6rem; left: clamp(1.5rem, 6.7vw, 8rem); display: inline-flex; align-items: center; gap: .5rem; color: #d7dfdc; font-size: .8rem; letter-spacing: .04em; pointer-events: none; }
  .gamma-plate:not([data-gamma-ready='true']) .gamma-hint { display: none; }
  .gamma-plate:not([data-gamma-ready='true']) .gamma-controls { visibility: hidden; pointer-events: none; }
  .gamma-controls { position: absolute; right: clamp(1.4rem, 6.7vw, 8rem); bottom: 1.1rem; z-index: 2; display: flex; gap: .15rem; padding: .3rem; border: 0; background: transparent; }
  .gamma-controls button { display: inline-flex; align-items: center; justify-content: center; gap: .42rem; min-height: 2.75rem; padding: .45rem .65rem; border: 0; border-radius: .35rem; color: #dfe1df; background: transparent; font: inherit; font-size: .8rem; white-space: nowrap; cursor: pointer; }
  .gamma-controls button:hover { background: rgb(240 238 216 / 9%); }
  .gamma-controls button[aria-pressed='true'] { color: #f1efeb; background: rgb(238 236 228 / 7%); }
  .gamma-controls button:focus-visible { outline: 2px solid #cbc7bd; outline-offset: 1px; }
  .gamma-controls button:disabled { cursor: default; opacity: .45; }
  .gamma-accessible { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 48rem) {
    .gamma-scene { aspect-ratio: 4 / 3; }
    .gamma-mark { top: 1.3rem; left: 1.25rem; font-size: 1.35rem; }
    .gamma-hint { top: 1.45rem; right: 1.25rem; bottom: auto; left: auto; font-size: .7rem; gap: .35rem; opacity: .7; }
    .gamma-controls { position: relative; inset: auto; justify-content: center; gap: .4rem; min-height: 3rem; padding: 0 1rem; background: #0d0f12; }
    .gamma-controls button { min-width: 4.1rem; min-height: 2.75rem; padding: .4rem .65rem; border-radius: 0; font-size: .78rem; gap: .3rem; }
    .gamma-controls button[aria-pressed='true'] { background: transparent; text-decoration: underline; text-decoration-color: #9a9b97; text-underline-offset: .45rem; }
    .gamma-controls button[data-gamma-preset] svg { display: none; }
    .gamma-controls button[data-gamma-reset] { min-width: 2.75rem; margin-left: .5rem; }
    .gamma-controls button[data-gamma-reset] span { display: none; }
    .gamma-controls svg { width: 16px; height: 16px; }
  }
  @media print {
    .gamma-plate { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .gamma-scene { aspect-ratio: 50 / 21; }
    .gamma-plate .gamma-poster { visibility: visible; }
    .gamma-canvas, .gamma-controls, .gamma-hint { display: none; }
    .gamma-mark { top: 1.5rem; }
  }
</style>
