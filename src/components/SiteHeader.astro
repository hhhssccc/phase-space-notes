---
import { siteConfig } from '../config/site';
import { withBase } from '../lib/content';

const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(withBase(href));
const navItems = siteConfig.nav.filter((item) => item.href !== '/search/' || siteConfig.features.search);
---

<a class="skip-link" href="#main-content">跳到正文</a>
<header class="site-header">
  <a class="site-name" href={withBase('/')} aria-label={`${siteConfig.name}首页`}>{siteConfig.name}</a>

  <nav class="main-nav" aria-label="主导航">
    {navItems.map((item) => (
      <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <button class="theme-toggle" type="button" data-theme-cycle aria-label="切换明暗模式" aria-pressed="false">明 / 暗</button>
  </nav>

  <div class="mobile-actions">
    <button class="theme-toggle" type="button" data-theme-cycle aria-label="切换明暗模式" aria-pressed="false">明 / 暗</button>
    <details class="mobile-menu">
      <summary>菜单</summary>
      <nav aria-label="手机导航">
        {navItems.map((item) => <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
