---
import { siteConfig } from '../config/site';
import { withBase } from '../lib/content';

interface Props { home?: boolean }
const { home = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(withBase(href));
const navItems = siteConfig.nav.filter((item) => item.href !== '/search/' || siteConfig.features.search);
const primaryItems = navItems.filter((item) => item.href !== '/search/');
---

<a class="skip-link" href="#main-content">跳到正文</a>
<header class:list={['site-header', { 'journal-header': home }]}>
  {home ? (
    <h1 class="masthead">
      <a class="site-name" href={withBase('/')} aria-label={`${siteConfig.name}首页`}>
        <svg class="journal-orbit" viewBox="0 0 48 48" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
          <ellipse cx="24" cy="24" rx="21" ry="8" />
          <ellipse cx="24" cy="24" rx="21" ry="8" transform="rotate(60 24 24)" />
          <ellipse cx="24" cy="24" rx="21" ry="8" transform="rotate(120 24 24)" />
          <circle cx="24" cy="24" r="3" fill="currentColor" />
        </svg>
        <span class="journal-wordmark"><span>{siteConfig.name}</span><span class="site-name-en" lang="en">Asymptotic Freedom</span></span>
      </a>
    </h1>
  ) : <a class="site-name" href={withBase('/')} aria-label={`${siteConfig.name}首页`}>{siteConfig.name}</a>}

  <nav class="main-nav" aria-label="主导航">
    {primaryItems.map((item) => (
      <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>

  <div class="header-actions">
    {siteConfig.features.search && (
      <a class="header-search" href={withBase('/search/')} aria-current={isActive('/search/') ? 'page' : undefined}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <span>搜索</span>
      </a>
    )}
    <button class="theme-toggle" type="button" data-theme-cycle aria-label="切换明暗模式" aria-pressed="false">主题</button>
  </div>

  <div class="mobile-actions">
    <button class="theme-toggle" type="button" data-theme-cycle aria-label="切换明暗模式" aria-pressed="false">主题</button>
    <details class="mobile-menu">
      <summary>{home ? <><span class="menu-strokes" aria-hidden="true"></span><span class="visually-hidden">菜单</span></> : '菜单'}</summary>
      <nav aria-label="手机导航">
        {navItems.map((item) => <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
        {home && <button class="theme-toggle" type="button" data-theme-cycle aria-label="切换明暗模式" aria-pressed="false">主题</button>}
      </nav>
    </details>
  </div>
</header>

<script>
  const currentMenu = () => document.querySelector<HTMLDetailsElement>('.mobile-menu');
  document.addEventListener('keydown', (event) => {
    const menu = currentMenu();
    const menuButton = menu?.querySelector('summary');
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menuButton?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    const menu = currentMenu();
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  window.matchMedia('(min-width: 48.001rem)').addEventListener('change', (event) => {
    const menu = currentMenu();
    if (event.matches && menu) menu.open = false;
  });
</script>
