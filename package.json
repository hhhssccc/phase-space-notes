{
  "name": "asymptotic-freedom-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run test:unit && astro check && astro build && npm run optimize:fonts && npm run validate:render && npm run validate:reading && npm run validate:regressions",
    "preview": "astro preview",
    "check": "astro check",
    "optimize:fonts": "node scripts/optimize-font-assets.mjs",
    "validate:render": "node scripts/check-render-contracts.mjs",
    "validate:reading": "node scripts/check-reading-tools.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "validate:regressions": "node tests/contracts/content-regressions.mjs",
    "validate:music": "node scripts/check-music-playlist.mjs",
    "validate:browser": "node scripts/check-site-browser.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.2.2",
    "katex": "0.16.47",
    "mermaid": "11.16.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
